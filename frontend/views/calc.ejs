<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora de Probabilidades</title>
    <meta name="description" content="Calculadora de probabilidades mediante datos de últimos encuentros.">
    
    <link rel="icon" type="image/png" sizes="32x32" href="https://mejv.pro/assets/images/icon.png">
    <link rel="apple-touch-icon" href="https://mejv.pro/assets/images/icon.png">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts: Space Grotesk & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        'mejv-blue': '#0041f2',
                        'mejv-dark': '#0a1e33',
                        'mejv-lime': '#bfeb30',
                        'mejv-white': '#ffffff',
                        'mejv-black': '#050c18',
                        'mejv-light-bg': '#f4f7fb',
                        'mejv-card-dark': '#0e263e',
                        'mejv-card-light': '#ffffff'
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        display: ['"Space Grotesk"', 'sans-serif'],
                    },
                    boxShadow: {
                        'neon-lime': '0 0 25px rgba(191, 235, 48, 0.4)',
                        'neon-blue': '0 0 25px rgba(0, 65, 242, 0.35)',
                        'light-card': '0 10px 30px -5px rgba(10, 30, 51, 0.08)'
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-mejv-black text-slate-100 font-sans antialiased p-4 md:p-6 min-h-screen selection:bg-mejv-lime selection:text-mejv-black">
    <div class="max-w-md mx-auto space-y-5">
        <header class="flex items-center justify-between pb-3 border-b border-slate-800">
            <div class="flex items-center gap-2">
                <i data-lucide="cpu" class="text-blue-500 w-5 h-5"></i>
                <h1 class="text-lg font-bold text-white">Calc<span class="text-blue-500">Odds</span></h1>
            </div>
            <a href="/analyze" class="text-[10px] px-2 py-0.5 rounded-full bg-blue-950 text-blue-400 border border-blue-800">
                <i data-lucide="refresh-ccw" class="text-white-500 w-5 h-5"></i>
            </a>
        </header>

        <div class="bg-mejv-card-dark border border-mejv-card-dark rounded-2xl p-4 space-y-4">
            <form action="/analyze" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">URL de Flashscore Mobi (H2H) Entra</label>
                    <input type="url" name="url" value="<%= lastUrl %>" placeholder="https://www.flashscore.mobi/match/rgl80UA3k/?t=h2h" required class="w-full bg-mejv-dark border border-slate-700 rounded-lg px-3 py-2 text-white font-mono text-sm focus:border-mejv-lime outline-none">
                </div>

                <div class="space-y-1 pt-1">
                    <label class="block text-[11px] font-semibold text-mejv-lime uppercase">Cuotas Adicionales (Opcional)</label>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <span class="text-[10px] text-slate-400 block mb-0.5">Cuota Over 2.5</span>
                            <input type="number" step="0.01" name="oddsOver" value="<%= data ? data.manualOddsOver : '' %>" placeholder="Ej: 3.34" class="w-full bg-mejv-dark border border-slate-700 rounded-lg px-2 py-2 text-center text-xs text-mejv-lime rounded-lg focus:outline-none">
                        </div>
                        <div>
                            <span class="text-[10px] text-slate-400 block mb-0.5">Cuota BTTS Sí</span>
                            <input type="number" step="0.01" name="oddsBtts" value="<%= data ? data.manualOddsBtts : '' %>" placeholder="Ej: 3.76" class="w-full bg-mejv-dark border border-slate-700 rounded-lg px-2 py-2 text-center text-xs text-mejv-lime rounded-lg focus:outline-none">
                        </div>
                    </div>
                </div>
                <div class="space-y-1 pt-1">
                    <label class="block text-[11px] font-semibold text-mejv-lime uppercase">
                        Cuotas Reales Casas: Top 3 Marcadores (Opcional)
                    </label>
                    <p class="text-[10px] text-slate-400 mb-1">
                        Ingresa las cuotas de tu casa de apuestas para calcular el Dutching real con tu dinero.
                    </p>
                    <div class="grid grid-cols-3 gap-2">
                        <div>
                            <span class="text-[10px] text-slate-400 block mb-0.5">Cuota #1</span>
                            <input type="number" step="0.01" name="oddsScore1" value="<%= data ? data.manualOddsScore1 : '' %>" placeholder="Ej: 12.0" class="w-full bg-mejv-dark border border-slate-700 rounded-lg px-2 py-2 text-center text-xs text-mejv-lime focus:outline-none">
                        </div>
                        <div>
                            <span class="text-[10px] text-slate-400 block mb-0.5">Cuota #2</span>
                            <input type="number" step="0.01" name="oddsScore2" value="<%= data ? data.manualOddsScore2 : '' %>" placeholder="Ej: 34.0" class="w-full bg-mejv-dark border border-slate-700 rounded-lg px-2 py-2 text-center text-xs text-mejv-lime focus:outline-none">
                        </div>
                        <div>
                            <span class="text-[10px] text-slate-400 block mb-0.5">Cuota #3</span>
                            <input type="number" step="0.01" name="oddsScore3" value="<%= data ? data.manualOddsScore3 : '' %>" placeholder="Ej: 101.0" class="w-full bg-mejv-dark border border-slate-700 rounded-lg px-2 py-2 text-center text-xs text-mejv-lime focus:outline-none">
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-1">
                    <label class="text-xs text-slate-400">Promedio Liga (xG por equipo):</label>
                    <input type="number" step="0.01" name="leagueAvg" value="<%= data ? data.leagueAvg : '1.10' %>" class="w-20 bg-mejv-dark border border-slate-700 rounded-lg p-1.5 text-center text-xs text-white rounded">
                </div>

                <button type="submit" class="w-full bg-mejv-blue hover:bg-mejv-blue/90 text-white font-semibold p-2.5 rounded-xl text-xs transition-all flex items-center justify-center gap-1.5">
                    <i class="fa-solid fa-bolt w-4 h-4"></i>
                    Analizar Partido & EV+
                </button>
            </form>
        </div>

        <% if (error) { %>
            <div class="p-3 bg-red-950/40 border border-red-500/30 rounded-xl text-red-400 text-xs flex items-center gap-2">
                <i class="fa-solid fa-triangle-exclamation w-4 h-4"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <% if (data) { %>
            <div class="space-y-4">
                <div class="bg-mejv-card-dark border border-mejv-card-dark rounded-2xl p-4 space-y-3">
                    <div class="flex justify-between items-center text-sm font-bold text-mejv-white px-1 gap-2">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <span class="text-mejv-lime"><%= data.homeTeam %></span>
                            <span class="text-[10px] bg-mejv-black border border-slate-700 px-1.5 py-0.5 rounded text-slate-300 font-mono">
                                <%= data.homeGF %>:<%= data.homeGC %>
                            </span>
                        </div>

                        <span class="text-[10px] text-slate-500 shrink-0">VS</span>

                        <div class="flex items-center gap-1.5 flex-wrap justify-end">
                            <span class="text-[10px] bg-mejv-black border border-slate-700 px-1.5 py-0.5 rounded text-slate-300 font-mono">
                                <%= data.awayGF %>:<%= data.awayGC %>
                            </span>
                            <span class="text-mejv-lime"><%= data.awayTeam %></span>
                        </div>
                    </div>

                    <div class="flex justify-between items-center bg-mejv-black p-2.5 rounded-xl border border-slate-800 text-center">
                        <div>
                            <p class="text-[10px] text-slate-400">xG Local</p>
                            <p class="text-base font-bold text-mejv-lime"><%= data.xgHome %></p>
                        </div>
                        <div>
                            <p class="text-[10px] text-slate-400">xG Combinado</p>
                            <p class="text-xs font-semibold text-slate-300"><%= data.xgTotal %></p>
                        </div>
                        <div>
                            <p class="text-[10px] text-slate-400">xG Visitante</p>
                            <p class="text-base font-bold text-mejv-lime"><%= data.xgAway %></p>
                        </div>
                    </div>
                </div>

                <div class="bg-mejv-card-dark border border-mejv-card-dark rounded-2xl p-4 space-y-2">
                    <h3 class="text-xs font-semibold text-mejv-lime uppercase tracking-wider flex items-center gap-1.5">
                        <i class="fa-solid fa-bullseye w-3.5 h-3.5"></i> Top 5 Marcadores Exactos
                    </h3>
                    <div class="grid grid-cols-5 gap-1.5">
                        <% data.topScores.forEach((s, index) => { %>
                            <div class="p-2 rounded-xl text-center space-y-0.5 <%= index === 0 ? 'border border-mejv-lime/80 bg-mejv-lime/10 text-mejv-lime' : 'bg-mejv-dark border border-slate-700 text-slate-300' %>">
                                <p class="text-xs font-extrabold"><%= s.score %></p>
                                <p class="text-[10px] opacity-80"><%= s.prob %></p>
                            </div>
                        <% }) %>
                    </div>
                </div>
                
                <!-- MÓDULO DUTCHING TOP 3 MARCADORES -->
                <div class="bg-mejv-card-dark border border-slate-800 rounded-2xl p-4 space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                        <h3 class="text-xs font-semibold text-mejv-lime uppercase tracking-wider flex items-center gap-1.5">
                            <i class="fa-solid fa-calculator text-mejv-lime"></i> Dutching Top 3 (Cobertura)
                        </h3>
                        <span class="text-[10px] bg-mejv-blue/50 text-mejv-lime border border-mejv-blue/40 px-2 py-0.5 rounded-full font-mono">
                            Cuota Aprox @<span id="dutching-cuota-comb"><%= data.dutchingTop3.cuotaCombinada %></span>
                        </span>
                    </div>
                
                    <div class="flex items-center justify-between bg-mejv-dark p-2.5 rounded-xl border border-slate-800 gap-3">
                        <div class="flex flex-col">
                            <span class="text-[10px] text-slate-400 font-semibold uppercase">Monto a usar:</span>
                            <span class="text-[10px] text-emerald-400">Ganancia Neta: $<span id="dutching-retorno-neto">0</span></span>
                        </div>
                        <div class="flex items-center gap-1 bg-mejv-black border border-slate-700 rounded-lg px-2 py-1">
                            <span class="text-xs text-slate-400 font-bold">$</span>
                            <input type="number" id="input-bankroll" value="100000" step="1000" min="1000" class="w-24 bg-transparent text-right text-xs font-bold text-mejv-lime outline-none">
                        </div>
                    </div>
                
                    <div class="flex justify-between items-center text-xs text-slate-300 px-1">
                        <span>Probabilidad Colectiva:</span>
                        <span class="font-bold text-mejv-lime text-sm"><%= data.dutchingTop3.probTotalPct %>%</span>
                    </div>
                
                    <div class="space-y-1.5 pt-1">
                        <p class="text-[10px] text-slate-400 uppercase font-semibold">Distribución de Apuesta Según Monto:</p>
                        <div class="grid grid-cols-3 gap-2">
                            <% data.dutchingTop3.items.forEach((item, idx) => { %>
                                <div class="bg-mejv-dark border border-slate-700 p-2 rounded-xl text-center flex flex-col justify-between">
                                    <div>
                                        <p class="text-xs font-bold text-white"><%= item.score %></p>
                                        <p class="text-[10px] text-slate-400">@<%= item.cuotaUsada %></p>
                                    </div>
                                    
                                    <div class="mt-2 pt-1.5 border-t border-slate-800/80">
                                        <span class="text-[10px] text-slate-400 block"><%= item.stakePct %>%</span>
                                        <p class="text-xs font-bold text-mejv-lime mt-0.5 item-amount" data-pct="<%= item.stakePct %>">$0</p>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>

                <div class="bg-mejv-card-dark border border-mejv-card-dark rounded-2xl p-4 space-y-2">
                    <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Mercados Principales & EV+</h3>
                    <div class="space-y-2">
                        <% data.mercados.forEach(item => { %>
                            <% 
                                let evBadge = '';
                                let borderStyle = 'border-slate-800 bg-mejv-dark/40';
                                if (item.ev !== null) {
                                    if (parseFloat(item.ev) > 0) {
                                        evBadge = `<span class="text-[10px] bg-emerald-500/20 text-emerald-400 font-bold px-2 py-0.5 rounded border border-emerald-500/30">EV+ ${item.ev}%</span>`;
                                        borderStyle = 'border-emerald-500/50 bg-emerald-950/20';
                                    } else {
                                        evBadge = `<span class="text-[10px] bg-rose-500/20 text-rose-400 font-medium px-2 py-0.5 rounded border border-rose-500/30">Sin Valor (${item.ev}%)</span>`;
                                    }
                                }
                            %>
                            <div class="flex items-center justify-between p-3 border <%= borderStyle %> rounded-xl text-xs">
                                <span class="text-slate-300 font-medium"><%= item.label %></span>
                                <div class="flex items-center gap-2">
                                    <%- evBadge %>
                                    <span class="font-bold text-mejv-white text-sm"><%= item.prob %>%</span>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
    <script>
        lucide.createIcons();
        document.addEventListener('DOMContentLoaded', () => {
            const inputBank = document.getElementById('input-bankroll');
            const amountElements = document.querySelectorAll('.item-amount');
            const retornoNetoEl = document.getElementById('dutching-retorno-neto');
            const cuotaCombEl = document.getElementById('dutching-cuota-comb');
    
            function recalcularDutching() {
                if (!inputBank) return;
    
                const bank = parseFloat(inputBank.value) || 0;
                const cuotaCombinada = parseFloat(cuotaCombEl.innerText) || 1;
    
                amountElements.forEach(el => {
                    const pct = parseFloat(el.getAttribute('data-pct')) || 0;
                    const montoMarcador = Math.round(((bank * pct) / 100) / 100) * 100;
                    el.innerText = '$' + montoMarcador.toLocaleString('es-CO');
                });
    
                const retornoTotal = bank * cuotaCombinada;
                const gananciaNeta = Math.max(0, Math.round(retornoTotal - bank));
                retornoNetoEl.innerText = gananciaNeta.toLocaleString('es-CO');
            }
    
            if (inputBank) {
                inputBank.addEventListener('input', recalcularDutching);
                recalcularDutching();
            }
        });
    </script>

</body>
</html>