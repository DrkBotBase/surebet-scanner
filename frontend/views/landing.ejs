    <!-- JAVASCRIPT LÓGICA E INTERACTIVIDAD -->
    <script>
        const menuBtn = document.getElementById('menu-btn');
        const sideMenu = document.getElementById('side-menu');
        const menuOverlay = document.getElementById('menu-overlay');
        const navLinks = document.querySelectorAll('.nav-link');

        function toggleMenu() {
            const isOpen = sideMenu.classList.contains('translate-x-0');
            
            if (isOpen) {
                sideMenu.classList.remove('translate-x-0');
                sideMenu.classList.add('translate-x-full');
                menuOverlay.classList.add('opacity-0');
                setTimeout(() => menuOverlay.classList.add('hidden'), 300);
                menuBtn.classList.remove('menu-open');
            } else {
                menuOverlay.classList.remove('hidden');
                setTimeout(() => menuOverlay.classList.remove('opacity-0'), 10);
                sideMenu.classList.remove('translate-x-full');
                sideMenu.classList.add('translate-x-0');
                menuBtn.classList.add('menu-open');
            }
        }

        menuBtn.addEventListener('click', toggleMenu);
        menuOverlay.addEventListener('click', toggleMenu);

        navLinks.forEach(link => {
            link.addEventListener('click', () => {
                if (!sideMenu.classList.contains('translate-x-full')) {
                    toggleMenu();
                }
            });
        });

        const slidesContainer = document.getElementById('carousel-slides');
        const prevBtn = document.getElementById('prev-slide');
        const nextBtn = document.getElementById('next-slide');
        const dots = document.querySelectorAll('.carousel-dot');
        let currentSlide = 0;
        const totalSlides = 3;

        function updateSlider(index) {
            currentSlide = (index + totalSlides) % totalSlides;
            slidesContainer.style.transform = `translateX(-${currentSlide * 100}%)`;
            
            dots.forEach((dot, idx) => {
                if (idx === currentSlide) {
                    dot.classList.remove('w-2', 'bg-slate-600');
                    dot.classList.add('w-8', 'bg-mejv-lime');
                } else {
                    dot.classList.remove('w-8', 'bg-mejv-lime');
                    dot.classList.add('w-2', 'bg-slate-600');
                }
            });
        }

        nextBtn.addEventListener('click', () => updateSlider(currentSlide + 1));
        prevBtn.addEventListener('click', () => updateSlider(currentSlide - 1));

        dots.forEach((dot, idx) => {
            dot.addEventListener('click', () => updateSlider(idx));
        });

        setInterval(() => {
            updateSlider(currentSlide + 1);
        }, 5000);

        const revealElements = document.querySelectorAll('.reveal');

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, {
            threshold: 0.15
        });

        revealElements.forEach(el => observer.observe(el));

        function openNewsModal(button) {
            const title = button.getAttribute('data-title');
            const body = button.getAttribute('data-body');
            document.getElementById('modal-news-title').innerText = title;
            document.getElementById('modal-news-body').innerText = body;
            const modal = document.getElementById('news-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeNewsModal() {
            const modal = document.getElementById('news-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function openSurebetCalculatorModal() {
            const modal = document.getElementById('surebet-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            calculateSurebet();
        }

        function closeSurebetCalculatorModal() {
            const modal = document.getElementById('surebet-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function calculateSurebet() {
            const total = parseFloat(document.getElementById('sb-total').value) || 0;
            const rounding = parseFloat(document.getElementById('sb-rounding').value) || 1;
            const c1 = parseFloat(document.getElementById('sb-c1').value) || 1;
            const c2 = parseFloat(document.getElementById('sb-c2').value) || 1;

            const inv1 = 1 / c1;
            const inv2 = 1 / c2;
            const sumInv = inv1 + inv2;


            let stake1 = (total * inv1) / sumInv;
            let stake2 = (total * inv2) / sumInv;

            stake1 = Math.round(stake1 / rounding) * rounding;
            stake2 = Math.round(stake2 / rounding) * rounding;

            const return1 = stake1 * c1;
            const return2 = stake2 * c2;
            const actualTotalStaked = stake1 + stake2;
            
            const profit = Math.min(return1, return2) - actualTotalStaked;
            const profitPct = (profit / actualTotalStaked) * 100;

            document.getElementById('sb-res-1').innerText = '$' + Math.round(stake1).toLocaleString();
            document.getElementById('sb-res-2').innerText = '$' + Math.round(stake2).toLocaleString();
            document.getElementById('sb-res-profit').innerText = `$${Math.round(profit).toLocaleString()} (${profitPct.toFixed(2)}%)`;
        }

        function openInteractiveCalculatorModal(e) {
            e.preventDefault();
            window.open('https://arbs.mejv.pro/arbs', '_blank');
        }

        async function verificarPendientes() {
            const elementosPendientes = document.querySelectorAll('.estado-pendiente');
            
            elementosPendientes.forEach(el => {
                if (el.dataset.estado === 'pendiente') {
                    el.textContent = '⏳';
                }
            });

            document.querySelectorAll('.mensaje-error-estados').forEach(el => el.remove());

            try {
                const response = await fetch('/api/verificar-pendientes');
                
                if (!response.ok) {
                    throw new Error(`Error HTTP: ${response.status}`);
                }
                
                let data;
                try {
                    data = await response.json();
                } catch (parseError) {
                    throw new Error('La respuesta no es un JSON válido');
                }
                
                if (!data || typeof data !== 'object') {
                    throw new Error('Datos inválidos del backend');
                }
                
                elementosPendientes.forEach(element => {
                    const fila = element.closest('tr');
                    const id = fila.dataset.id;
                    
                    if (!id) {
                        console.warn('Fila sin data-id:', fila);
                        return;
                    }
                    
                    const estadoBackend = data[id];
                    
                    if (estadoBackend === true) {
                        element.textContent = '✅';
                        element.dataset.estado = 'verificado';
                    } else if (estadoBackend === false) {
                        element.textContent = '❌';
                        element.dataset.estado = 'fallido';
                    } else {
                        element.textContent = '⏳';
                        element.dataset.estado = 'pendiente';
                    }
                });
            } catch (error) {
                console.warn('⚠️ No se pudieron obtener los estados del backend:', error.message);
                
                elementosPendientes.forEach(element => {
                    if (element.dataset.estado !== 'verificado' && element.dataset.estado !== 'fallido') {
                        element.textContent = '⏳';
                        element.dataset.estado = 'pendiente';
                    }
                });
                
                mostrarMensajeError('No se pudieron cargar los estados de verificación');
            }
        }

        function mostrarMensajeError(mensaje) {
            const existingMessage = document.querySelector('.mensaje-error-estados');
            if (existingMessage) {
                existingMessage.remove();
            }
            
            const messageDiv = document.createElement('div');
            messageDiv.className = 'mensaje-error-estados bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-2 rounded-lg text-sm flex items-center gap-2 mb-4';
            messageDiv.innerHTML = `
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>${mensaje}</span>
            `;
            
            const tablaPronosticos = document.querySelector('#Pronosticos .bg-mejv-card-dark');
            if (tablaPronosticos) {
                tablaPronosticos.parentElement.insertBefore(messageDiv, tablaPronosticos);
            }
        }
        function simularBackend() {
            // Simular datos de ejemplo
            const datosSimulados = {
                'rijeka-ilves': true,
                'benfica-hearts': false,
                'ajax-shelbourne': true,
                'ajax-shelbourne-goles': false,
                'benfica-hearts-goles': true,
                'paok-anderlecht-goles': false
            };
            
            document.querySelectorAll('.estado-pendiente').forEach(element => {
                const fila = element.closest('tr');
                const id = fila.dataset.id;
                
                if (id && datosSimulados[id] !== undefined) {
                    if (datosSimulados[id] === true) {
                        element.textContent = '✅';
                        element.dataset.estado = 'verificado';
                    } else if (datosSimulados[id] === false) {
                        element.textContent = '❌';
                        element.dataset.estado = 'fallido';
                    }
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            verificarPendientes().catch(() => {
                simularBackend();
            });
        });

        // setInterval(verificarPendientes, 120000);
        
        window.verificarPendientes = verificarPendientes;
        window.simularBackend = simularBackend;
    </script>
</body>
</html>