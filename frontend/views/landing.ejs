<!DOCTYPE html>
<html lang="es" class="scroll-smooth dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>MEJV Sports | Surebets, Pronósticos y Análisis Deportivo</title>
    <meta name="description" content="Descubre las mejores surebets sin riesgo, pronósticos deportivos precisos y herramientas de análisis en MEJV Sports. Calculadora de goles y noticias actualizadas.">
    
    <link rel="icon" type="image/png" sizes="32x32" href="https://mejv.pro/assets/images/icon.png">
    <link rel="apple-touch-icon" href="https://mejv.pro/assets/images/icon.png">
    
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://arbs.mejv.pro/">
    <meta property="og:title" content="MEJV Sports - Surebets y Pronósticos">
    <meta property="og:description" content="Herramientas de análisis, surebets sin riesgo y los mejores pronósticos deportivos.">
    <meta property="og:image" content="https://arbs.mejv.pro/images/banner.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="MEJV Sports - Surebets y Pronósticos">
    <meta name="twitter:description" content="Herramientas de análisis, surebets sin riesgo y pronósticos deportivos.">
    <meta name="twitter:image" content="https://arbs.mejv.pro/images/banner.jpg">
    
    <link rel="canonical" href="https://arbs.mejv.pro/">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">  
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        'mejv-blue': '#0041f2',
                        'mejv-dark': '#0a1e33',
                        'mejv-lime': '#bfeb30',
                        'mejv-white': '#ffffff',
                        'mejv-black': '#050c18',
                        'mejv-light-bg': '#f4f7fb',
                        'mejv-card-dark': '#0e263e',
                        'mejv-card-light': '#ffffff'
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        display: ['"Space Grotesk"', 'sans-serif'],
                    },
                    boxShadow: {
                        'neon-lime': '0 0 25px rgba(191, 235, 48, 0.4)',
                        'neon-blue': '0 0 25px rgba(0, 65, 242, 0.35)',
                        'light-card': '0 10px 30px -5px rgba(10, 30, 51, 0.08)'
                    }
                }
            }
        }
    </script>
    <style>
        .hamburger-line {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            transform-origin: center;
        }
        .menu-open .line1 {
            transform: translateY(7px) rotate(45deg);
        }
        .menu-open .line2 {
            opacity: 0;
            transform: scaleX(0);
        }
        .menu-open .line3 {
            transform: translateY(-7px) rotate(-45deg);
        }

        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        .custom-scrollbar::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #050c18;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #0e263e;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #bfeb30;
        }

        .estado-pendiente[data-estado="pendiente"] {
            color: #fbbf24;
        }
        .estado-pendiente[data-estado="verificado"] {
            color: #4ade80;
        }
        .estado-pendiente[data-estado="fallido"] {
            color: #f87171;
        }
        
        .estado-pendiente[data-estado="pendiente"] {
            animation: pulse 1.5s ease-in-out infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .mensaje-error-estados {
            animation: slideDown 0.3s ease-out;
        }
        
        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body class="bg-mejv-black text-slate-100 font-sans antialiased selection:bg-mejv-lime selection:text-mejv-black">
    <nav class="fixed top-0 left-0 w-full z-50 bg-mejv-black/90 backdrop-blur-md border-b border-mejv-card-dark transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2.5 group">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center text-mejv-lime shadow-neon-blue bg-mejv-black">
                    <img src="https://mejv.pro/assets/images/icon.png" alt="icon mejv" class="w-7 h-7">
                </div>
                <div class="flex flex-col">
                    <span class="font-display font-black text-xl tracking-wider text-mejv-white leading-tight">MEJV<span class="text-mejv-lime">SPORTS</span></span>
                    <span class="text-[9px] text-slate-400 font-bold tracking-widest uppercase">Análisis & Surebets</span>
                </div>
            </a>

            <button id="menu-btn" aria-label="Abrir Menú" class="p-2.5 rounded-xl bg-mejv-card-dark text-slate-200 hover:text-mejv-lime hover:bg-mejv-dark border border-mejv-card-dark focus:outline-none transition-colors z-50">
                <div class="w-6 h-5 flex flex-col justify-between items-center">
                    <span class="line1 hamburger-line w-6 h-0.5 bg-current rounded-full"></span>
                    <span class="line2 hamburger-line w-6 h-0.5 bg-current rounded-full"></span>
                    <span class="line3 hamburger-line w-6 h-0.5 bg-current rounded-full"></span>
                </div>
            </button>
        </div>
    </nav>
    <div id="menu-overlay" class="fixed inset-0 bg-mejv-black/80 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-300"></div>
    <aside id="side-menu" class="fixed top-0 right-0 h-full w-80 max-w-[85vw] bg-mejv-dark/95 border-l border-mejv-card-dark z-40 transform translate-x-full transition-transform duration-300 ease-out flex flex-col pt-24 px-6 pb-8 justify-between shadow-2xl">
        <div class="space-y-6">
            <div class="text-xs font-display font-bold uppercase tracking-widest text-mejv-lime border-b border-mejv-card-dark pb-2">Navegación</div>
            <ul class="space-y-3">
                <li>
                    <a href="#Inicio" class="nav-link flex items-center gap-3 text-lg font-semibold text-slate-200 hover:text-mejv-lime hover:bg-mejv-card-dark px-4 py-3 rounded-xl transition-all">
                        <i class="fa-solid fa-house w-5 text-mejv-lime"></i> Inicio
                    </a>
                </li>
                <li>
                    <a href="#Noticias" class="nav-link flex items-center gap-3 text-lg font-semibold text-slate-200 hover:text-mejv-lime hover:bg-mejv-card-dark px-4 py-3 rounded-xl transition-all">
                        <i class="fa-solid fa-newspaper w-5 text-mejv-blue"></i> Noticias
                    </a>
                </li>
                <li>
                    <a href="#Surebets" class="nav-link flex items-center gap-3 text-lg font-semibold text-slate-200 hover:text-mejv-lime hover:bg-mejv-card-dark px-4 py-3 rounded-xl transition-all">
                        <i class="fa-solid fa-calculator w-5 text-mejv-lime"></i> Surebets
                    </a>
                </li>
                <li>
                    <a href="#Pronosticos" class="nav-link flex items-center gap-3 text-lg font-semibold text-slate-200 hover:text-mejv-lime hover:bg-mejv-card-dark px-4 py-3 rounded-xl transition-all">
                        <i class="fa-solid fa-chart-line w-5 text-mejv-lime"></i> Pronósticos
                    </a>
                </li>
                <li>
                    <a href="#Calculadora" class="nav-link flex items-center gap-3 text-lg font-semibold text-slate-200 hover:text-mejv-lime hover:bg-mejv-card-dark px-4 py-3 rounded-xl transition-all">
                        <i class="fa-solid fa-futbol w-5 text-mejv-blue"></i> Calculadora de Goles
                    </a>
                </li>
            </ul>
        </div>

        <div class="pt-6 border-t border-mejv-card-dark text-center">
            <p class="text-xs text-slate-400">MEJV Sports Analytics &copy; 2026</p>
            <span class="inline-block mt-2 px-3 py-1 bg-mejv-lime/10 text-mejv-lime text-xs rounded-full font-semibold border border-mejv-lime/30">
                <i class="fa-solid fa-circle text-[8px] animate-pulse mr-1"></i> En vivo
            </span>
        </div>
    </aside>

    <header id="Inicio" class="pt-16 relative overflow-hidden bg-mejv-black">
        <div class="relative w-full h-[70vh] sm:h-[80vh] min-h-[480px] overflow-hidden">
            <div id="carousel-slides" class="w-full h-full flex transition-transform duration-700 ease-out">
                <!-- Slide 1 -->
                <div class="w-full h-full flex-shrink-0 relative">
                    <img src="https://www.catapult.com/wp-content/uploads/2024/06/FC_koln_matchtracker_shot_from_video_cropped-scaled-1.jpg" alt="Análisis Deportivo" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-mejv-black via-mejv-black/60 to-transparent flex items-end">
                        <div class="max-w-7xl mx-auto px-6 pb-12 w-full reveal">
                            <span class="px-3 py-1 bg-mejv-lime text-mejv-black font-display font-bold text-xs rounded-full uppercase tracking-wider shadow-neon-lime">Surebets & Apuestas</span>
                            <h1 class="font-display text-3xl sm:text-5xl font-extrabold text-mejv-white mt-3 leading-tight max-w-2xl">
                                Maximiza tus rendimientos con <span class="text-mejv-lime">Surebets Seguras</span>
                            </h1>
                            <p class="text-slate-300 mt-2 text-sm sm:text-base max-w-xl">
                                Cobertura total sin riesgo, calculada en tiempo real para los mejores eventos deportivos.
                            </p>
                        </div>
                    </div>
                </div>
                <!-- Slide 2 -->
                <div class="w-full h-full flex-shrink-0 relative">
                    <img src="https://images.unsplash.com/photo-1574629810360-7efbbe195018?auto=format&fit=crop&w=1400&q=80" alt="Balón de fútbol" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-mejv-black via-mejv-black/60 to-transparent flex items-end">
                        <div class="max-w-7xl mx-auto px-6 pb-12 w-full">
                            <span class="px-3 py-1 bg-mejv-blue text-mejv-white font-display font-bold text-xs rounded-full uppercase tracking-wider shadow-neon-blue">Pronósticos Premium</span>
                            <h2 class="font-display text-3xl sm:text-5xl font-extrabold text-mejv-white mt-3 leading-tight max-w-2xl">
                                Análisis Estadístico de <span class="text-mejv-blue">Alto Valor</span>
                            </h2>
                            <p class="text-slate-300 mt-2 text-sm sm:text-base max-w-xl">
                                Predicciones respaldadas por algoritmos de probabilidades y rendimiento reciente.
                            </p>
                        </div>
                    </div>
                </div>
                <!-- Slide 3 -->
                <div class="w-full h-full flex-shrink-0 relative">
                    <img src="https://images.unsplash.com/photo-1518091043644-c1d4457512c6?auto=format&fit=crop&w=1400&q=80" alt="Estrategia táctica" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-mejv-black via-mejv-black/60 to-transparent flex items-end">
                        <div class="max-w-7xl mx-auto px-6 pb-12 w-full">
                            <span class="px-3 py-1 bg-mejv-lime text-mejv-black font-display font-bold text-xs rounded-full uppercase tracking-wider shadow-neon-lime">Herramientas Tácticas</span>
                            <h2 class="font-display text-3xl sm:text-5xl font-extrabold text-mejv-white mt-3 leading-tight max-w-2xl">
                                Calculadora de <span class="text-mejv-lime">Goles Pro</span>
                            </h2>
                            <p class="text-slate-300 mt-2 text-sm sm:text-base max-w-xl">
                                Evalúa marcadores esperados y líneas Over/Under con alta precisión.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Controles del Slider -->
            <button id="prev-slide" aria-label="Anterior Slide" class="absolute left-4 top-1/2 -translate-y-1/2 p-3 rounded-full bg-mejv-card-dark/80 text-mejv-white hover:bg-mejv-lime hover:text-mejv-black transition-all backdrop-blur-md border border-slate-700">
                <i class="fa-solid fa-chevron-left text-sm sm:text-base"></i>
            </button>
            <button id="next-slide" aria-label="Siguiente Slide" class="absolute right-4 top-1/2 -translate-y-1/2 p-3 rounded-full bg-mejv-card-dark/80 text-mejv-white hover:bg-mejv-lime hover:text-mejv-black transition-all backdrop-blur-md border border-slate-700">
                <i class="fa-solid fa-chevron-right text-sm sm:text-base"></i>
            </button>

            <!-- Indicadores de Slide -->
            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex space-x-2 z-10">
                <button class="carousel-dot w-8 h-2 rounded-full bg-mejv-lime transition-all"></button>
                <button class="carousel-dot w-2 h-2 rounded-full bg-slate-600 transition-all"></button>
                <button class="carousel-dot w-2 h-2 rounded-full bg-slate-600 transition-all"></button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-20">
        <!-- SECCIÓN NOTICIAS DEPORTIVAS -->
        <section id="Noticias" class="reveal">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 border-b border-mejv-card-dark pb-4 gap-2">
                <div>
                    <span class="text-mejv-lime text-xs font-display font-bold uppercase tracking-widest">Actualidad</span>
                    <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-mejv-white flex items-center gap-2">
                        <i class="fa-solid fa-newspaper text-mejv-lime text-xl"></i> Noticias Deportivas
                    </h2>
                </div>
                <p class="text-slate-400 text-xs sm:text-sm">Últimas novedades, análisis tácticos y tendencias de cuotas</p>
            </div>

            <!-- Grid de Noticias -->
            <% if (news.length === 0) { %>
                <div class="bg-mejv-card-dark border border-slate-800 rounded-2xl p-8 text-center">
                    <i class="fa-solid fa-newspaper text-slate-600 text-4xl mb-4"></i>
                    <h3 class="text-mejv-white font-display font-bold text-lg mb-2">No hay noticias disponibles</h3>
                    <p class="text-slate-400 text-sm">Pronto tendremos nuevas actualizaciones.</p>
                </div>
            <% } else { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% news.forEach(item => { %>
                    <article class="bg-mejv-card-dark rounded-2xl overflow-hidden border border-slate-800 hover:border-mejv-blue transition-all duration-300 hover:-translate-y-1 flex flex-col group shadow-lg">
                        <div class="relative h-48 overflow-hidden">
                            <img src="<%= item.imageUrl %>" alt="<%= item.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <span class="absolute top-3 left-3 bg-mejv-black/90 backdrop-blur-md text-mejv-lime text-xs px-2.5 py-1 rounded-md font-bold font-display"><%= item.category %></span>
                        </div>
                        <div class="p-5 flex-1 flex flex-col justify-between">
                            <div>
                                <span class="text-slate-400 text-xs flex items-center gap-1 mb-2">
                                    <i class="fa-regular fa-clock"></i> <%= item.createdAt.toLocaleDateString() %>
                                </span>
                                <h3 class="font-display text-lg font-bold text-mejv-white group-hover:text-mejv-lime transition-colors leading-snug mb-2">
                                    <%= item.title %>
                                </h3>
                                <p class="text-slate-400 text-sm line-clamp-3">
                                    <%= item.body %>
                                </p>
                            </div>
                            <button data-title="<%= item.title %>" data-body="<%= item.body %>" onclick="openNewsModal(this)" class="mt-4 text-mejv-lime font-display font-semibold text-sm flex items-center gap-1 hover:gap-2 transition-all">
                                Ver más <i class="fa-solid fa-arrow-right text-xs"></i>
                            </button>
                        </div>
                    </article>
                    <% }) %>
                </div>
            <% } %>
        </section>
        <!-- SECCIÓN SUREBET -->
        <section id="Surebets" class="reveal">
            <div class="bg-gradient-to-br from-mejv-black via-mejv-dark to-mejv-black p-6 sm:p-8 rounded-3xl border border-mejv-lime/30 shadow-neon-lime/10 relative overflow-hidden">
                <!-- Badge decorativo -->
                <div class="absolute -right-10 -top-10 w-40 h-40 bg-mejv-lime/10 rounded-full blur-3xl pointer-events-none"></div>

                <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
                    <div>
                        <div class="inline-flex items-center gap-2 px-3 py-1 bg-mejv-lime/10 text-mejv-lime border border-mejv-lime/30 rounded-full text-xs font-bold uppercase tracking-wider mb-2">
                            <i class="fa-solid fa-shield-halved animate-pulse"></i> Arbitraje Matemático
                        </div>
                        <h2 class="font-display text-2xl sm:text-4xl font-extrabold text-mejv-white">
                            Oportunidades <span class="text-mejv-lime">Surebet</span> Publicadas
                        </h2>
                        <p class="text-slate-400 text-sm mt-1">Apuestas cruzadas con beneficio 100% garantizado sin importar el resultado.</p>
                    </div>

                    <!-- Botón para abrir la calculadora interactiva -->
                    <button onclick="openSurebetCalculatorModal()" class="self-start md:self-auto px-5 py-3 bg-mejv-lime hover:bg-mejv-lime/90 text-mejv-black font-display font-bold text-sm rounded-xl transition-all shadow-neon-lime flex items-center gap-2">
                        <i class="fa-solid fa-calculator"></i> Calculadora Surebet
                    </button>
                </div>

                <!-- Lista de Cards Surebets -->
                <div class="space-y-4">
                    <% if (surebets.length === 0) { %>
                        <div class="bg-mejv-dark/80 border border-slate-800 rounded-2xl p-8 text-center">
                            <i class="fa-solid fa-shield-halved text-slate-600 text-4xl mb-4"></i>
                            <h3 class="text-mejv-white font-display font-bold text-lg mb-2">No hay surebets disponibles</h3>
                            <p class="text-slate-400 text-sm">Estamos analizando nuevos eventos para ti.</p>
                        </div>
                    <% } else { %>
                        <% surebets.forEach(surebet => { %>
                        <!-- Surebet -->
                        <div class="bg-mejv-dark/80 border border-slate-800 rounded-2xl p-5 hover:border-mejv-lime/50 transition-all duration-300">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-800/80 gap-2">
                                <div>
                                    <h3 class="font-display text-xl font-bold text-mejv-white flex items-center gap-2">
                                        <i class="fa-solid fa-trophy text-mejv-lime text-sm"></i> <%= surebet.event %>
                                    </h3>
                                    <p class="text-slate-400 text-xs mt-0.5">
                                        📅 <%= moment(surebet.eventDate).tz("America/Bogota").format('DD/MM') %> | <%= surebet.time %>
                                    </p>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="px-3 py-1 bg-mejv-card-dark text-slate-300 text-xs rounded-lg font-medium"><%= surebet.market %></span>
                                    <span class="px-3 py-1 bg-mejv-lime/20 text-mejv-lime border border-mejv-lime/40 font-extrabold text-xs sm:text-sm rounded-lg font-display">
                                        Línea: <%= surebet.line %> - <%= surebet.percentage %>%
                                    </span>
                                </div>
                            </div>

                            <!-- Comparativa en Formato Tabular / Grid -->
                            <div class="mt-4 grid grid-cols-2 gap-4 text-center">
                                <div class="bg-mejv-card-dark p-3 rounded-xl border border-slate-800">
                                    <div class="text-xs font-bold font-display text-mejv-lime mb-1 uppercase tracking-wider"><%= surebet.bookmaker1 %></div>
                                    <div class="text-lg font-black text-mejv-white font-display"><%= surebet.line.includes('+') ? '+' : '-' %><%= surebet.line.replace(/[+-]/g, '') %> <span class="text-mejv-lime text-sm font-semibold">(<%= surebet.odds1 %>)</span></div>
                                    <div class="text-xs text-slate-400 mt-1">Stake: <span class="text-mejv-white font-bold">...</span></div>
                                </div>
                                <div class="bg-mejv-card-dark p-3 rounded-xl border border-slate-800">
                                    <div class="text-xs font-bold font-display text-mejv-lime mb-1 uppercase tracking-wider"><%= surebet.bookmaker2 %></div>
                                    <div class="text-lg font-black text-mejv-white font-display"><%= surebet.line.includes('+') ? '-' : '+' %><%= surebet.line.replace(/[+-]/g, '') %> <span class="text-mejv-lime text-sm font-semibold">(<%= surebet.odds2 %>)</span></div>
                                    <div class="text-xs text-slate-400 mt-1">Stake: <span class="text-mejv-white font-bold">...</span></div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </section>
<!-- SECCIÓN PRONÓSTICOS DEPORTIVOS -->
<section id="Pronosticos" class="reveal">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 border-b border-mejv-card-dark pb-4 gap-2">
        <div>
            <span class="text-mejv-lime text-xs font-display font-bold uppercase tracking-widest">Predicciones Diarias</span>
            <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-mejv-white flex items-center gap-2">
                <i class="fa-solid fa-chart-line text-mejv-lime text-xl"></i> Pronósticos Deportivos
            </h2>
        </div>
        <div class="flex items-center gap-3">
            <span class="text-xs text-slate-400">Actualizado: Agosto 2026</span>
