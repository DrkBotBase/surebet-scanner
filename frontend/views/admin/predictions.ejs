<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestionar Pronósticos - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root {
          --bg-color: #edebe4;
          --text-color: #1a1c21;
          --primary-color: #e21c1b;
          --light-shadow: #dbd7c5;
          --dark-shadow: #cac7b5;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Inter', sans-serif;
        }
        .neumorphic-flat {
            background: var(--bg-color);
            box-shadow: 7px 7px 15px var(--dark-shadow), -7px -7px 15px var(--light-shadow);
        }
        .neumorphic-input {
            background: var(--bg-color);
            box-shadow: inset 4px 4px 8px var(--dark-shadow), inset -4px -4px 8px var(--light-shadow);
            border: none;
            outline: none;
        }
        .neumorphic-button {
            background: var(--bg-color);
            box-shadow: 5px 5px 10px var(--dark-shadow), -5px -5px 10px var(--light-shadow);
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .neumorphic-button:active {
            box-shadow: inset 3px 3px 6px var(--dark-shadow), inset -3px -3px 6px var(--light-shadow);
            transform: scale(0.98);
        }
    </style>
</head>
<body class="p-4 md:p-8">
    <div class="max-w-6xl mx-auto">
        <header class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
            <h1 class="text-3xl font-bold" style="color: var(--primary-color);">Gestionar Pronósticos</h1>
            <div class="flex gap-4">
                <a href="/admin" class="neumorphic-button px-4 py-2 rounded-lg text-sm">Dashboard</a>
                <a href="/admin/logout" class="neumorphic-button px-4 py-2 rounded-lg text-sm text-red-500">Cerrar Sesión</a>
            </div>
        </header>
        
        <form action="/admin/predictions" method="POST" class="neumorphic-flat p-6 rounded-xl mb-8 grid grid-cols-1 md:grid-cols-3 gap-4">
            <input type="text" name="event" placeholder="Encuentro" class="neumorphic-input p-3 rounded-lg" required>
            <input type="date" name="eventDate" placeholder="Fecha del Encuentro" class="neumorphic-input p-3 rounded-lg" required>
            <input type="time" name="time" placeholder="Hora" class="neumorphic-input p-3 rounded-lg" required>
            <input type="text" name="prediction" placeholder="Pronóstico" class="neumorphic-input p-3 rounded-lg" required>
            <input type="text" name="odds" placeholder="Cuota" class="neumorphic-input p-3 rounded-lg" required>
            <input type="text" name="bookmaker" placeholder="Casa" class="neumorphic-input p-3 rounded-lg" required>
            <button type="submit" class="neumorphic-button p-3 rounded-lg font-bold">Crear Pronóstico</button>
        </form>

        <div class="grid gap-4">
            <% data.forEach(d => { %>
                <div class="neumorphic-flat p-4 rounded-xl flex justify-between items-center border-l-4 <%= d.status === 'verificado' ? 'border-green-500' : (d.status === 'fallido' ? 'border-red-500' : 'border-yellow-500') %>">
                    <div>
                        <span class="font-bold text-lg"><%= d.event %></span>
                        <span class="block text-sm opacity-70"><%= d.prediction %> | <%= d.status.toUpperCase() %></span>
                    </div>
                    <div class="flex gap-2">
                        <form action="/admin/predictions/status/<%= d._id %>" method="POST">
                            <input type="hidden" name="status" value="verificado">
                            <button type="submit" class="neumorphic-button px-3 py-1 rounded text-xs font-bold">VERIFICADO</button>
                        </form>
                        <form action="/admin/predictions/status/<%= d._id %>" method="POST">
                            <input type="hidden" name="status" value="fallido">
                            <button type="submit" class="neumorphic-button px-3 py-1 rounded text-xs font-bold">FALLIDO</button>
                        </form>
                        <form action="/admin/predictions/delete/<%= d._id %>" method="POST">
                            <button type="submit" class="neumorphic-button px-3 py-1 rounded text-xs font-bold">BORRAR</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
    <script>
        lucide.createIcons();
    </script>
</body>
</html>
