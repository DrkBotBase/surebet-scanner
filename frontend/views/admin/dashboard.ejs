<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
  <title>Panel de Administración · MEJV Sports</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome 6 (gratis) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts: Space Grotesk & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
        darkMode: 'class',
        theme: {
            extend: {
                colors: {
                    'mejv-blue': '#0041f2',
                    'mejv-blue-dark': '#0033cc',
                    'mejv-dark': '#0a1e33',
                    'mejv-lime': '#bfeb30',
                    'mejv-lime-dark': '#a3cb1d',
                    'mejv-white': '#ffffff',
                    'mejv-black': '#050c18',
                    'mejv-card-dark': '#0e263e',
                    'mejv-card-hover': '#14314f'
                },
                fontFamily: {
                    sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    display: ['"Space Grotesk"', 'sans-serif'],
                },
                boxShadow: {
                    'neon-lime': '0 0 15px rgba(191, 235, 48, 0.25)',
                    'neon-blue': '0 0 15px rgba(0, 65, 242, 0.25)',
                    'card-glow': '0 4px 20px rgba(5, 12, 24, 0.15)'
                }
            }
        }
    }
  </script>

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .modal-overlay { backdrop-filter: blur(6px); }
    .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    input, select, textarea { font-size: 16px !important; }
    
    /* Custom scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #050c18;
    }
    ::-webkit-scrollbar-thumb {
      background: #0e263e;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #bfeb30;
    }
  </style>
</head>
<body class="bg-mejv-black text-gray-100 font-sans antialiased min-h-screen selection:bg-mejv-lime selection:text-mejv-black">

  <!-- ========== HEADER ========== -->
  <header class="bg-mejv-dark sticky top-0 z-20 border-b border-gray-800 shadow-neon-blue">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="bg-mejv-lime text-mejv-black p-2 rounded-xl flex items-center justify-center shadow-neon-lime">
          <i class="fas fa-chart-line text-lg"></i>
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-bold font-display text-white tracking-wide">MEJV Sports</h1>
          <p class="text-[10px] text-mejv-lime font-bold uppercase tracking-widest leading-none">Admin Panel</p>
        </div>
      </div>
      <div class="flex items-center gap-4 text-sm">
        <span class="hidden md:inline text-gray-400 font-medium">
          <i class="far fa-calendar-alt mr-1.5 text-mejv-lime"></i><span id="header-date">--.--.----</span>
        </span>
        <div class="flex items-center gap-2">
          <a href="/" target="_blank" class="bg-mejv-card-dark hover:bg-mejv-card-hover border border-gray-800 text-gray-300 hover:text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-1">
            <i class="fas fa-external-link-alt text-[10px]"></i> Ver Sitio
          </a>
          <a href="/admin/logout" class="bg-rose-950/40 hover:bg-rose-900/60 border border-rose-800/50 text-rose-300 hover:text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-1">
            <i class="fas fa-sign-out-alt"></i> Salir
          </a>
        </div>
      </div>
    </div>
    
    <!-- MENU PESTAÑAS (TABS) -->
    <nav class="max-w-7xl mx-auto px-4 flex gap-1 overflow-x-auto border-t border-gray-800 scrollbar-none">
      <button data-tab="noticias" class="tab-btn py-3 px-4 text-xs font-bold text-gray-400 border-b-2 border-transparent hover:text-mejv-lime hover:border-mejv-lime/40 whitespace-nowrap transition flex items-center gap-2 active">
        <i class="fas fa-newspaper text-sm"></i>Noticias
      </button>
      <button data-tab="surebets" class="tab-btn py-3 px-4 text-xs font-bold text-gray-400 border-b-2 border-transparent hover:text-mejv-lime hover:border-mejv-lime/40 whitespace-nowrap transition flex items-center gap-2">
        <i class="fas fa-percent text-sm"></i>Surebets
      </button>
      <button data-tab="pronosticos" class="tab-btn py-3 px-4 text-xs font-bold text-gray-400 border-b-2 border-transparent hover:text-mejv-lime hover:border-mejv-lime/40 whitespace-nowrap transition flex items-center gap-2">
        <i class="fas fa-futbol text-sm"></i>Pronósticos
      </button>
      <button data-tab="tablagoles" class="tab-btn py-3 px-4 text-xs font-bold text-gray-400 border-b-2 border-transparent hover:text-mejv-lime hover:border-mejv-lime/40 whitespace-nowrap transition flex items-center gap-2">
        <i class="fas fa-bullseye text-sm"></i>Tabla Goles
      </button>
    </nav>
  </header>

  <!-- ========== CONTENIDO PRINCIPAL ========== -->
  <main class="max-w-7xl mx-auto px-4 py-6 pb-24">

    <!-- ===== SECCIÓN NOTICIAS ===== -->
    <section id="section-noticias" class="tab-content">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
          <h2 class="text-xl font-bold font-display flex items-center gap-2 text-white">
            <i class="fas fa-newspaper text-mejv-lime"></i> Gestión de Noticias
          </h2>
          <p class="text-xs text-gray-400">Publica artículos, fichajes y novedades deportivas de MEJV Sports</p>
        </div>
        <div class="flex gap-2 items-center">
          <input type="text" id="search-noticias" placeholder="Buscar noticia..." class="bg-mejv-card-dark border border-gray-800 text-xs px-3 py-2 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-mejv-lime transition w-44" />
          <button id="btnCrearNoticia" class="bg-mejv-blue hover:bg-mejv-blue-dark text-white text-xs font-bold px-4 py-2 rounded-lg shadow-neon-blue flex items-center gap-1.5 transition">
            <i class="fas fa-plus-circle"></i> Crear Noticia
          </button>
        </div>
      </div>
      
      <!-- Contenedor lista -->
      <div id="noticias-list" class="space-y-4"></div>
    </section>

    <!-- ===== SECCIÓN SUREBETS ===== -->
    <section id="section-surebets" class="tab-content hidden">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
          <h2 class="text-xl font-bold font-display flex items-center gap-2 text-white">
            <i class="fas fa-percent text-emerald-400"></i> Arbitraje de Surebets
          </h2>
          <p class="text-xs text-gray-400">Gestiona surebets de apuestas seguras con porcentaje de retorno garantizado</p>
        </div>
        <div class="flex gap-2 items-center">
          <input type="text" id="search-surebets" placeholder="Buscar encuentro..." class="bg-mejv-card-dark border border-gray-800 text-xs px-3 py-2 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-mejv-lime transition w-44" />
          <button id="btnCrearSurebet" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-4 py-2 rounded-lg shadow flex items-center gap-1.5 transition">
            <i class="fas fa-plus-circle"></i> Crear Surebet
          </button>
        </div>
      </div>
      
      <!-- Contenedor lista -->
      <div id="surebets-list" class="space-y-4"></div>
    </section>

    <!-- ===== SECCIÓN PRONÓSTICOS ===== -->
    <section id="section-pronosticos" class="tab-content hidden">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
          <h2 class="text-xl font-bold font-display flex items-center gap-2 text-white">
            <i class="fas fa-futbol text-mejv-blue"></i> Pronósticos Premium
          </h2>
          <p class="text-xs text-gray-400">Publica predicciones de cuotas de partidos y evalúa su estatus final</p>
        </div>
        <div class="flex gap-2 items-center">
          <input type="text" id="search-pronosticos" placeholder="Buscar encuentro..." class="bg-mejv-card-dark border border-gray-800 text-xs px-3 py-2 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-mejv-lime transition w-44" />
          <button id="btnCrearPronostico" class="bg-mejv-blue hover:bg-mejv-blue-dark text-white text-xs font-bold px-4 py-2 rounded-lg shadow-neon-blue flex items-center gap-1.5 transition">
            <i class="fas fa-plus-circle"></i> Crear Pronóstico
          </button>
        </div>
      </div>
      
      <!-- Contenedor lista -->
      <div id="pronosticos-list" class="space-y-4"></div>
    </section>

    <!-- ===== SECCIÓN TABLA DE GOLES ===== -->
    <section id="section-tablagoles" class="tab-content hidden">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
          <h2 class="text-xl font-bold font-display flex items-center gap-2 text-white">
            <i class="fas fa-bullseye text-mejv-lime"></i> Tabla de Goles
          </h2>
          <p class="text-xs text-gray-400">Administra recomendaciones para apuestas del mercado de over/under de goles</p>
        </div>
        <div class="flex gap-2 items-center">
          <input type="text" id="search-tablagoles" placeholder="Buscar liga o evento..." class="bg-mejv-card-dark border border-gray-800 text-xs px-3 py-2 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-mejv-lime transition w-44" />
          <button id="btnCrearTablaGoles" class="bg-mejv-lime hover:bg-mejv-lime-dark text-mejv-black text-xs font-extrabold px-4 py-2 rounded-lg shadow-neon-lime flex items-center gap-1.5 transition">
            <i class="fas fa-plus-circle"></i> Crear Entrada
          </button>
        </div>
      </div>
      
      <!-- Contenedor lista -->
      <div id="tablagoles-list" class="space-y-4"></div>
    </section>

  </main>

  <!-- ========== MODAL REUTILIZABLE ========== -->
  <div id="modalOverlay" class="fixed inset-0 bg-mejv-black/80 modal-overlay flex items-center justify-center z-50 hidden p-3">
    <div class="bg-mejv-dark border border-gray-800 rounded-2xl w-full max-w-xl shadow-2xl max-h-[92vh] overflow-y-auto transform transition duration-300 scale-95 opacity-0" id="modalContainer">
      
      <!-- Modal Header -->
      <div class="sticky top-0 bg-mejv-dark/95 backdrop-blur-md z-10 px-6 py-4 border-b border-gray-800 flex items-center justify-between rounded-t-2xl">
        <h3 id="modalTitle" class="text-base font-bold font-display text-white flex items-center gap-2">Crear</h3>
        <button id="modalClose" class="text-gray-400 hover:text-mejv-lime text-2xl transition duration-150 leading-none">&times;</button>
      </div>
      
      <!-- Modal Body -->
      <div class="p-6">
        <form id="modalForm" class="space-y-4">
          <!-- campos dinámicos se inyectan aquí -->
          <div id="modalFields" class="space-y-4 text-gray-300"></div>
          
          <!-- botones -->
          <div class="flex justify-end gap-2.5 pt-4 border-t border-gray-800/60">
            <button type="button" id="modalCancel" class="px-4 py-2 text-xs font-bold border border-gray-800 rounded-xl text-gray-400 hover:text-white hover:bg-gray-800/50 transition">Cancelar</button>
            <button type="submit" id="modalSubmit" class="px-5 py-2 text-xs font-bold bg-mejv-blue hover:bg-mejv-blue-dark text-white rounded-xl shadow-neon-blue flex items-center gap-1.5 transition"><i class="fas fa-save"></i> Guardar Cambios</button>
          </div>
        </form>
        
        <!-- para surebets: mostrar cálculo en tiempo real -->
        <div id="surebetCalculo" class="mt-4 text-xs bg-mejv-black/60 border border-gray-800 p-4 rounded-xl hidden shadow-inner"></div>
      </div>
    </div>
  </div>

  <!-- ========== SCRIPTS ========== -->
  <script>
    // Configurar la fecha de hoy en el header del admin
    (function setHeaderDate() {
      const today = new Date();
      const options = { year: 'numeric', month: '2-digit', day: '2-digit' };
      document.getElementById('header-date').textContent = today.toLocaleDateString('es-ES', options);
    })();

    // ============================================================
    // 1. REAL API CONNECTION
    // ============================================================
    const api = {
      // Noticias
      getNoticias: () => fetch('/admin/api/news').then(handleResponse),
      crearNoticia: (formData) => fetch('/admin/api/news', { method: 'POST', body: formData }).then(handleResponse),
      editarNoticia: (id, formData) => fetch(`/admin/api/news/edit/${id}`, { method: 'POST', body: formData }).then(handleResponse),
      eliminarNoticia: (id) => fetch(`/admin/api/news/delete/${id}`, { method: 'POST' }).then(handleResponse),

      // Pronósticos
      getPronosticos: () => fetch('/admin/api/predictions').then(handleResponse),
      crearPronostico: (data) => fetch('/admin/api/predictions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).then(handleResponse),
      editarPronostico: (id, data) => fetch(`/admin/api/predictions/edit/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).then(handleResponse),
      eliminarPronostico: (id) => fetch(`/admin/api/predictions/delete/${id}`, { method: 'POST' }).then(handleResponse),
      togglePronosticoEstado: (id, status) => fetch(`/admin/api/predictions/status/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      }).then(handleResponse),

      // Surebets
      getSurebets: () => fetch('/admin/api/surebets').then(handleResponse),
      crearSurebet: (data) => fetch('/admin/api/surebets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).then(handleResponse),
      editarSurebet: (id, data) => fetch(`/admin/api/surebets/edit/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).then(handleResponse),
      eliminarSurebet: (id) => fetch(`/admin/api/surebets/delete/${id}`, { method: 'POST' }).then(handleResponse),

      // Tabla Goles
      getTablaGoles: () => fetch('/admin/api/goal-tables').then(handleResponse),
      crearTablaGoles: (data) => fetch('/admin/api/goal-tables', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).then(handleResponse),
      editarTablaGoles: (id, data) => fetch(`/admin/api/goal-tables/edit/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).then(handleResponse),
      eliminarTablaGoles: (id) => fetch(`/admin/api/goal-tables/delete/${id}`, { method: 'POST' }).then(handleResponse),
      toggleTablaGolesEstado: (id, status) => fetch(`/admin/api/goal-tables/status/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      }).then(handleResponse),
      
      // Refresh
      refreshMatch: (type, id) => fetch(`/admin/api/refresh-match/${type}/${id}`, { method: 'POST' }).then(handleResponse)
    };

    function handleResponse(res) {
      if (!res.ok) {
        return res.json().then(err => { throw new Error(err.error || 'Error en la petición') });
      }
      return res.json();
    }

    // Almacenamiento local del estado para búsquedas en tiempo real
    const localState = {
      noticias: [],
      surebets: [],
      pronosticos: [],
      tablagoles: []
    };

    // ============================================================
    // 2. UTILIDADES DE NOTIFICACIÓN & COMPONENTES COMUNES
    // ============================================================
    function showToast(message, type = 'success') {
      const toast = document.createElement('div');
      toast.className = `fixed bottom-5 right-5 z-50 px-5 py-3 rounded-xl shadow-2xl border text-xs font-extrabold flex items-center gap-2 transform translate-y-10 opacity-0 transition-all duration-300 ${
        type === 'success' 
          ? 'bg-emerald-950/90 border-emerald-500 text-emerald-400 shadow-emerald-950/50' 
          : 'bg-rose-950/90 border-rose-500 text-rose-400 shadow-rose-950/50'
      }`;
      
      const icon = document.createElement('i');
      icon.className = type === 'success' ? 'fas fa-check-circle text-sm text-emerald-400' : 'fas fa-exclamation-circle text-sm text-rose-400';
      
      toast.appendChild(icon);
      toast.appendChild(document.createTextNode(message));
      
      document.body.appendChild(toast);
      
      setTimeout(() => {
        toast.classList.remove('translate-y-10', 'opacity-0');
      }, 10);
      
      setTimeout(() => {
        toast.classList.add('translate-y-10', 'opacity-0');
        setTimeout(() => {
          toast.remove();
        }, 300);
      }, 4000);
    }

    function renderEmptyState(container, mensaje, btnId, actionSection) {
      container.innerHTML = `
        <div class="bg-mejv-card-dark border border-dashed border-gray-800 rounded-2xl p-8 text-center shadow-card-glow max-w-xl mx-auto my-6">
          <div class="w-12 h-12 rounded-full bg-gray-900 flex items-center justify-center mx-auto mb-3">
            <i class="fas fa-folder-open text-gray-600 text-lg"></i>
          </div>
          <p class="text-gray-400 text-xs mb-4 font-semibold">${mensaje}</p>
          <button id="${btnId}" class="bg-mejv-lime hover:bg-mejv-lime-dark text-mejv-black text-xs font-extrabold px-4 py-2 rounded-xl transition shadow-neon-lime"><i class="fas fa-plus mr-1.5"></i>Registrar el Primero</button>
        </div>
      `;
      document.getElementById(btnId)?.addEventListener('click', () => abrirModal(actionSection, 'crear'));
    }

    function renderSpinner(container) {
      container.innerHTML = `
        <div class="flex flex-col items-center justify-center py-12 gap-3">
          <div class="w-8 h-8 border-4 border-mejv-blue border-t-mejv-lime rounded-full animate-spin"></div>
          <p class="text-xs text-gray-400 font-semibold tracking-wider uppercase">Cargando datos...</p>
        </div>
      `;
    }

    function formatInputDate(dateStr) {
      if (!dateStr) return '';
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return '';
      const year = d.getUTCFullYear();
      const month = String(d.getUTCMonth() + 1).padStart(2, '0');
      const day = String(d.getUTCDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    function formatDisplayDate(dateStr) {
      if (!dateStr) return '';
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return '';
      const options = { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'UTC' };
      return d.toLocaleDateString('es-ES', options);
    }

    // ============================================================
    // 3. RENDERIZADO DE TABLAS / LISTADOS
    // ============================================================
    function renderTablaNoticias(lista, container) {
      if (!lista.length) {
        renderEmptyState(container, 'No se encontraron noticias en esta sección.', 'btnEmptyCrearNoticia', 'noticias');
        return;
      }
      let html = `
        <div class="bg-mejv-card-dark border border-gray-800 rounded-2xl shadow-card-glow overflow-hidden">
          <div class="table-wrap">
            <table class="w-full text-xs text-left">
              <thead class="bg-mejv-black text-gray-400 font-bold uppercase tracking-wider border-b border-gray-800">
                <tr>
                  <th class="px-4 py-3">Título</th>
                  <th class="px-4 py-3 hidden sm:table-cell">Descripción</th>
                  <th class="px-4 py-3">Tag / Categoria</th>
                  <th class="px-4 py-3 text-center">Imagen</th>
                  <th class="px-4 py-3 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-800/60">
      `;
      lista.forEach(n => {
        html += `
          <tr class="hover:bg-mejv-card-hover/40 transition duration-100">
            <td class="px-4 py-3 font-semibold text-white max-w-xs truncate">${escapaHTML(n.title)}</td>
            <td class="px-4 py-3 text-gray-400 hidden sm:table-cell max-w-sm truncate">${escapaHTML(n.body)}</td>
            <td class="px-4 py-3 whitespace-nowrap">
              <span class="bg-mejv-blue/20 border border-mejv-blue/40 text-mejv-blue px-2 py-0.5 rounded-full text-[10px] font-bold uppercase">${escapaHTML(n.category || 'General')}</span>
            </td>
            <td class="px-4 py-3 text-center">
              ${n.imageUrl ? `<img src="${n.imageUrl}" alt="img" class="h-9 w-9 rounded-lg object-cover mx-auto border border-gray-800" onerror="this.src='https://placehold.co/100x100/0e263e/white?text=No+Img'" />` : '<span class="text-gray-600 font-medium">sin imagen</span>'}
            </td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <button data-id="${n._id}" data-accion="editar" class="bg-mejv-blue/10 hover:bg-mejv-blue text-mejv-blue hover:text-white w-7 h-7 rounded-lg transition mr-1" title="Editar"><i class="fas fa-edit text-[10px]"></i></button>
              <button data-id="${n._id}" data-accion="eliminar" class="bg-rose-950/20 hover:bg-rose-600 text-rose-400 hover:text-white w-7 h-7 rounded-lg transition" title="Eliminar"><i class="fas fa-trash-alt text-[10px]"></i></button>
            </td>
          </tr>
        `;
      });
      html += `</tbody></table></div></div>`;
      container.innerHTML = html;
      
      // Event listeners
      container.querySelectorAll('[data-accion="editar"]').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.id;
          const item = localState.noticias.find(n => n._id === id);
          if (item) abrirModal('noticias', 'editar', item);
        });
      });
      container.querySelectorAll('[data-accion="eliminar"]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id;
          if (confirm('¿Estás seguro de que deseas eliminar esta noticia?')) {
            try {
              await api.eliminarNoticia(id);
              showToast('Noticia eliminada correctamente');
              cargarNoticias();
            } catch (err) {
              showToast('Error al eliminar: ' + err.message, 'error');
            }
          }
        });
      });
    }

