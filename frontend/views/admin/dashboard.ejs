            <div>
              <label class="block text-[10px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Fecha</label>
              <input id="f_eventDate" type="date" class="w-full bg-mejv-black border border-gray-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-mejv-blue transition" value="${data ? formatInputDate(data.eventDate) : new Date().toISOString().split('T')[0]}" required />
            </div>
            <div>
              <label class="block text-[10px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Hora</label>
              <input id="f_time" type="time" class="w-full bg-mejv-black border border-gray-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-mejv-blue transition" value="${data ? data.time || '' : ''}" required />
            </div>
          </div>
          <div>
            <label class="block text-[10px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Recomendación Goles</label>
            <select id="f_prediction" class="w-full bg-mejv-black border border-gray-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-mejv-blue transition" required>
              <option value="">Seleccione una opción</option>
              <option value="over 2.5" ${data && data.prediction === 'over 2.5' ? 'selected' : ''}>Over 2.5 Goles</option>
              <option value="under 2.5" ${data && data.prediction === 'under 2.5' ? 'selected' : ''}>Under 2.5 Goles</option>
              <option value="over 0.5" ${data && data.prediction === 'over 0.5' ? 'selected' : ''}>Over 0.5 Goles</option>
              <option value="under 0.5" ${data && data.prediction === 'under 0.5' ? 'selected' : ''}>Under 0.5 Goles</option>
            </select>
          </div>
          <div>
            <label class="block text-[10px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Marcador</label>
            <input id="f_score" type="text" class="w-full bg-mejv-black border border-gray-800 rounded-xl px-3 py-2 text-xs text-white placeholder-gray-600 focus:outline-none focus:border-mejv-blue transition" placeholder="ej: 0:0" value="${data ? escapaHTML(data.score || '0:0') : '0:0'}" required />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-[10px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Casa</label>
              <input id="f_bookmaker" type="text" class="w-full bg-mejv-black border border-gray-800 rounded-xl px-3 py-2 text-xs text-white placeholder-gray-600 focus:outline-none focus:border-mejv-blue transition" placeholder="ej: Pinnacle" value="${data ? escapaHTML(data.bookmaker) : ''}" required />
            </div>
            <div>
              <label class="block text-[10px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Cuota</label>
              <input id="f_odds" type="text" class="w-full bg-mejv-black border border-gray-800 rounded-xl px-3 py-2 text-xs text-white placeholder-gray-600 focus:outline-none focus:border-mejv-blue transition font-mono" placeholder="ej: 1.91" value="${data ? data.odds || '' : ''}" required />
            </div>
          </div>
          <div>
            <label class="block text-[10px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Estado</label>
            <select id="f_status" class="w-full bg-mejv-black border border-gray-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-mejv-blue transition">
              <option value="pendiente" ${data && data.status === 'pendiente' ? 'selected' : ''}>Pendiente</option>
              <option value="verificado" ${data && data.status === 'verificado' ? 'selected' : ''}>Ganado</option>
              <option value="fallido" ${data && data.status === 'fallido' ? 'selected' : ''}>Perdido</option>
              <option value="return" ${data && data.status === 'return' ? 'selected' : ''}>Reembolso</option>
              <option value="live" ${data && data.status === 'live' ? 'selected' : ''}>En Vivo</option>
              <option value="finished" ${data && data.status === 'finished' ? 'selected' : ''}>Finalizado</option>
              <option value="not_started" ${data && data.status === 'not_started' ? 'selected' : ''}>No Iniciado</option>
            </select>
          </div>
        `;
        
        // Scraping
        if (action === 'crear') {
          document.getElementById('btnScrape')?.addEventListener('click', async () => {
            const id = document.getElementById('f_scrapeId').value.trim();
            const statusP = document.getElementById('scrapeStatus');
            if(!id) return;
            
            statusP.textContent = "Obteniendo datos...";
            statusP.classList.remove('hidden', 'text-rose-400');
            statusP.classList.add('text-mejv-lime');
            
            try {
              const res = await fetch('/admin/api/scrape-match', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
              });
              const data = await res.json();
              
              if(!res.ok) throw new Error(data.error);
              
              document.getElementById('f_event').value = `${data.team1.name} vs ${data.team2.name}`;
              document.getElementById('f_score').value = data.score;
              document.getElementById('f_status').value = 'pendiente';
              
              if(data.datetime && data.datetime.iso) {
                document.getElementById('f_eventDate').value = formatInputDate(data.datetime.iso);
              }
              if (data.datetime && data.datetime.colombia) {
                const timePart = data.datetime.colombia.split(' ')[1];
                if (timePart) document.getElementById('f_time').value = timePart;
              }
              
              document.getElementById('f_team1_name').value = data.team1.name;
              document.getElementById('f_team1_logo').value = data.team1.logo || '';
              document.getElementById('f_team2_name').value = data.team2.name;
              document.getElementById('f_team2_logo').value = data.team2.logo || '';
              document.getElementById('f_flashscoreId').value = data.id;
              
              statusP.textContent = "✅ Datos cargados correctamente";
              statusP.classList.add('text-emerald-400');
            } catch(err) {
              statusP.textContent = `❌ Error: ${err.message}`;
              statusP.classList.add('text-rose-400');
            }
          });
        }
        
        submitBtn.innerHTML = `<i class="fas fa-save"></i> ${action === 'crear' ? 'Registrar' : 'Guardar'}`;
      }

      // Visual feedback to animate modal open
      overlay.classList.remove('hidden');
      setTimeout(() => {
        modalContainer.classList.remove('scale-95', 'opacity-0');
        modalContainer.classList.add('scale-100', 'opacity-100');
      }, 50);

      // Submit listener
      const form = document.getElementById('modalForm');
      form.onsubmit = async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<i class="fas fa-circle-notch animate-spin mr-1"></i> Procesando...`;
        await guardarModal();
      };
    }

    async function guardarModal() {
      const section = currentSection;
      const action = currentAction;
      const id = editId;

      try {
        if (section === 'noticias') {
          const fileInput = document.getElementById('f_imagen_file');
          const formData = new FormData();
          
          formData.append('title', document.getElementById('f_title').value.trim());
          formData.append('body', document.getElementById('f_body').value.trim());
          formData.append('category', document.getElementById('f_category').value.trim());
          
          if (fileInput && fileInput.files && fileInput.files[0]) {
            formData.append('image', fileInput.files[0]);
          } else {
            formData.append('imageUrl', document.getElementById('f_imagen').value.trim());
          }

          if (action === 'crear') {
            await api.crearNoticia(formData);
            showToast('Noticia creada con éxito!');
          } else {
            await api.editarNoticia(id, formData);
            showToast('Noticia actualizada con éxito!');
          }
          cerrarModal();
          cargarNoticias();

        } else if (section === 'surebets') {
          const v1 = parseFloat(document.getElementById('f_odds1').value);
          const v2 = parseFloat(document.getElementById('f_odds2').value);
          const arb = (1/v1 + 1/v2);
          const percentageStr = ((1/arb - 1) * 100).toFixed(2) + '%';

          const data = {
            event: document.getElementById('f_event').value.trim(),
            eventDate: new Date(document.getElementById('f_eventDate').value + 'T00:00:00Z'),
            time: document.getElementById('f_time').value,
            market: document.getElementById('f_market').value.trim(),
            line: document.getElementById('f_line').value.trim(),
            bookmaker1: document.getElementById('f_bookmaker1').value.trim(),
            odds1: document.getElementById('f_odds1').value,
            bookmaker2: document.getElementById('f_bookmaker2').value.trim(),
            odds2: document.getElementById('f_odds2').value,
            percentage: percentageStr
          };

          if (action === 'crear') {
            await api.crearSurebet(data);
            showToast('Surebet agregada correctamente!');
          } else {
            await api.editarSurebet(id, data);
            showToast('Surebet actualizada correctamente!');
          }
          cerrarModal();
          cargarSurebets();

        } else if (section === 'pronosticos') {
          const data = {
            event: document.getElementById('f_event').value.trim(),
            team1: { 
                name: document.getElementById('f_team1_name').value.trim(),
                logo: document.getElementById('f_team1_logo').value.trim()
            },
            team2: { 
                name: document.getElementById('f_team2_name').value.trim(),
                logo: document.getElementById('f_team2_logo').value.trim()
            },
            flashscoreId: document.getElementById('f_flashscoreId').value.trim(),
            eventDate: new Date(document.getElementById('f_eventDate').value + 'T00:00:00Z'),
            time: document.getElementById('f_time').value,
            prediction: document.getElementById('f_prediction').value.trim(),
            cornersUrl: document.getElementById('f_cornersUrl').value.trim(),
            score: document.getElementById('f_score').value.trim(),
            bookmaker: document.getElementById('f_bookmaker').value.trim(),
            odds: document.getElementById('f_odds').value.trim(),
            status: document.getElementById('f_status').value
          };

          if (action === 'crear') {
            await api.crearPronostico(data);
            showToast('Pronóstico publicado correctamente!');
          } else {
            await api.editarPronostico(id, data);
            showToast('Pronóstico actualizado correctamente!');
          }
          cerrarModal();
          cargarPronosticos();

        } else if (section === 'tablagoles') {
          const data = {
            league: document.getElementById('f_league').value.trim(),
            event: document.getElementById('f_event').value.trim(),
            team1: { 
                name: document.getElementById('f_team1_name').value.trim(),
                logo: document.getElementById('f_team1_logo').value.trim()
            },
            team2: { 
                name: document.getElementById('f_team2_name').value.trim(),
                logo: document.getElementById('f_team2_logo').value.trim()
            },
            flashscoreId: document.getElementById('f_flashscoreId').value.trim(),
            eventDate: new Date(document.getElementById('f_eventDate').value + 'T00:00:00Z'),
            time: document.getElementById('f_time').value,
            prediction: document.getElementById('f_prediction').value.trim(),
            cornersUrl: document.getElementById('f_cornersUrl').value.trim(),
            score: document.getElementById('f_score').value.trim(),
            bookmaker: document.getElementById('f_bookmaker').value.trim(),
            odds: document.getElementById('f_odds').value.trim(),
            status: document.getElementById('f_status').value
          };

          if (action === 'crear') {
            await api.crearTablaGoles(data);
            showToast('Entrada agregada a la Tabla de Goles!');
          } else {
            await api.editarTablaGoles(id, data);
            showToast('Entrada de goles actualizada!');
          }
          cerrarModal();
          cargarTablaGoles();
        }
      } catch (err) {
        showToast('Error al guardar: ' + err.message, 'error');
      } finally {
        const submitBtn = document.getElementById('modalSubmit');
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<i class="fas fa-save"></i> Guardar`;
      }
    }

    function cerrarModal() {
      const overlay = document.getElementById('modalOverlay');
      const modalContainer = document.getElementById('modalContainer');
      
      modalContainer.classList.remove('scale-100', 'opacity-100');
      modalContainer.classList.add('scale-95', 'opacity-0');
      
      setTimeout(() => {
        overlay.classList.add('hidden');
        document.getElementById('modalForm').onsubmit = null;
      }, 150);
    }

    // Modal Close Listeners
    document.getElementById('modalClose').addEventListener('click', cerrarModal);
    document.getElementById('modalCancel').addEventListener('click', cerrarModal);
    document.getElementById('modalOverlay').addEventListener('click', function(e) {
      if (e.target === this) cerrarModal();
    });

    // ============================================================
    // 5. CARGA DE DATOS & REAL-TIME FILTERS
    // ============================================================
    async function cargarNoticias() {
      const container = document.getElementById('noticias-list');
      renderSpinner(container);
      try {
        const data = await api.getNoticias();
        localState.noticias = data;
        filtrarYMostrarNoticias();
      } catch (err) {
        container.innerHTML = `<div class="text-rose-500 font-semibold text-center text-xs py-8 bg-mejv-card-dark border border-gray-800 rounded-2xl"><i class="fas fa-exclamation-triangle mr-1"></i>Error: ${err.message}</div>`;
      }
    }

    async function cargarSurebets() {
      const container = document.getElementById('surebets-list');
      renderSpinner(container);
      try {
        const data = await api.getSurebets();
        localState.surebets = data;
        filtrarYMostrarSurebets();
      } catch (err) {
        container.innerHTML = `<div class="text-rose-500 font-semibold text-center text-xs py-8 bg-mejv-card-dark border border-gray-800 rounded-2xl"><i class="fas fa-exclamation-triangle mr-1"></i>Error: ${err.message}</div>`;
      }
    }

    async function cargarPronosticos() {
      const container = document.getElementById('pronosticos-list');
      renderSpinner(container);
      try {
        const data = await api.getPronosticos();
        localState.pronosticos = data;
        filtrarYMostrarPronosticos();
      } catch (err) {
        container.innerHTML = `<div class="text-rose-500 font-semibold text-center text-xs py-8 bg-mejv-card-dark border border-gray-800 rounded-2xl"><i class="fas fa-exclamation-triangle mr-1"></i>Error: ${err.message}</div>`;
      }
    }

    async function cargarTablaGoles() {
      const container = document.getElementById('tablagoles-list');
      renderSpinner(container);
      try {
        const data = await api.getTablaGoles();
        localState.tablagoles = data;
        filtrarYMostrarTablaGoles();
      } catch (err) {
        container.innerHTML = `<div class="text-rose-500 font-semibold text-center text-xs py-8 bg-mejv-card-dark border border-gray-800 rounded-2xl"><i class="fas fa-exclamation-triangle mr-1"></i>Error: ${err.message}</div>`;
      }
    }

    // Funciones de Filtrado en Tiempo Real (Client-side)
    function filtrarYMostrarNoticias() {
      const q = document.getElementById('search-noticias').value.trim().toLowerCase();
      const filtrados = localState.noticias.filter(n => 
        n.title.toLowerCase().includes(q) || 
        n.body.toLowerCase().includes(q) || 
        (n.category && n.category.toLowerCase().includes(q))
      );
      renderTablaNoticias(filtrados, document.getElementById('noticias-list'));
    }

    function filtrarYMostrarSurebets() {
      const q = document.getElementById('search-surebets').value.trim().toLowerCase();
      const filtrados = localState.surebets.filter(s => 
        s.event.toLowerCase().includes(q) || 
        s.market.toLowerCase().includes(q) || 
        (s.line && s.line.toLowerCase().includes(q)) ||
        (s.bookmaker1 && s.bookmaker1.toLowerCase().includes(q)) ||
        (s.bookmaker2 && s.bookmaker2.toLowerCase().includes(q))
      );
      renderTablaSurebets(filtrados, document.getElementById('surebets-list'));
    }

    function filtrarYMostrarPronosticos() {
      const q = document.getElementById('search-pronosticos').value.trim().toLowerCase();
      const filtrados = localState.pronosticos.filter(p => 
        p.event.toLowerCase().includes(q) || 
        p.prediction.toLowerCase().includes(q) || 
        (p.bookmaker && p.bookmaker.toLowerCase().includes(q))
      );
      renderTablaPronosticos(filtrados, document.getElementById('pronosticos-list'));
    }

    function filtrarYMostrarTablaGoles() {
      const q = document.getElementById('search-tablagoles').value.trim().toLowerCase();
      const filtrados = localState.tablagoles.filter(t => 
        t.league.toLowerCase().includes(q) || 
        t.event.toLowerCase().includes(q) || 
        t.prediction.toLowerCase().includes(q) || 
        (t.bookmaker && t.bookmaker.toLowerCase().includes(q))
      );
      renderTablaTablaGoles(filtrados, document.getElementById('tablagoles-list'));
    }

    // Configurar listeners de búsquedas en tiempo real
    document.getElementById('search-noticias').addEventListener('input', filtrarYMostrarNoticias);
    document.getElementById('search-surebets').addEventListener('input', filtrarYMostrarSurebets);
    document.getElementById('search-pronosticos').addEventListener('input', filtrarYMostrarPronosticos);
    document.getElementById('search-tablagoles').addEventListener('input', filtrarYMostrarTablaGoles);

    // ============================================================
    // 6. NAVEGACIÓN TABS & BOOTSTRAP
    // ============================================================
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        // Remover estilos de activo de todos
        document.querySelectorAll('.tab-btn').forEach(b => {
          b.classList.remove('text-mejv-lime', 'border-mejv-lime', 'shadow-neon-lime');
          b.classList.add('text-gray-400', 'border-transparent');
        });
        // Agregar activo al seleccionado
        this.classList.remove('text-gray-400', 'border-transparent');
        this.classList.add('text-mejv-lime', 'border-mejv-lime');
        
        const tab = this.dataset.tab;
        
        // Ocultar todos los contenidos
        document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
        // Mostrar actual
        if (tab) {
          document.getElementById('section-' + tab).classList.remove('hidden');
        }
        
        // Cargar los datos correspondientes al cambiar de tab
        if (tab === 'noticias') cargarNoticias();
        else if (tab === 'surebets') cargarSurebets();
        else if (tab === 'pronosticos') cargarPronosticos();
        else if (tab === 'tablagoles') cargarTablaGoles();
      });
    });

    // ============================================================
    // 7. ACCIONES GLOBALES (Validar y Scraper)
    // ============================================================
    document.getElementById('btnValidarTodos').addEventListener('click', async () => {
      const pendientes = localState.pronosticos.filter(p => p.status === 'pendiente');
      if(pendientes.length === 0) return showToast('No hay pendientes para validar');
      
      if(!confirm(`¿Validar ${pendientes.length} encuentros pendientes?`)) return;
      
      showToast(`Iniciando validación de ${pendientes.length} encuentros...`, 'success');
      
      let count = 0;
      for (const p of pendientes) {
        try {
          await api.refreshMatch('prediction', p._id);
          count++;
        } catch(e) { console.error(e); }
      }
      showToast(`Validación completada: ${count}/${pendientes.length} actualizados`);
      cargarPronosticos();
      if (document.getElementById('section-tablagoles').classList.contains('hidden') === false) {
        cargarTablaGoles();
      }
    });

    // Scraper toggle desde navegación
    let scraperEnabled = false;
    const btnScraper = document.getElementById('toggleScraperBtn');
    
    api.getScraperConfig().then(data => {
      scraperEnabled = data.enabled;
      actualizarBottonScraper();
    });
    
    function actualizarBottonScraper() {
      if (scraperEnabled) {
        btnScraper.classList.remove('text-gray-400', 'bg-mejv-lime/5');
        btnScraper.classList.add('text-mejv-lime', 'bg-mejv-lime/20', 'border-mejv-lime/50');
        btnScraper.innerHTML = `<i class="fas fa-robot text-sm"></i> Scraper ON`;
      } else {
        btnScraper.classList.remove('text-mejv-lime', 'bg-mejv-lime/20', 'border-mejv-lime/50');
        btnScraper.classList.add('text-gray-400', 'bg-mejv-lime/5');
        btnScraper.innerHTML = `<i class="fas fa-robot text-sm"></i> Scraper OFF`;
      }
    }
    
    btnScraper.addEventListener('click', async () => {
      try {
        const newState = !scraperEnabled;
        await api.toggleScraper(newState);
        scraperEnabled = newState;
        actualizarBottonScraper();
        showToast(newState ? 'Scraper automático activado' : 'Scraper automático desactivado');
      } catch (e) {
        showToast('Error al actualizar configuración', 'error');
      }
    });

    // Registrar disparadores para botones "Crear" externos
    document.getElementById('btnCrearNoticia').addEventListener('click', () => abrirModal('noticias', 'crear'));
    document.getElementById('btnCrearSurebet').addEventListener('click', () => abrirModal('surebets', 'crear'));
    document.getElementById('btnCrearPronostico').addEventListener('click', () => abrirModal('pronosticos', 'crear'));
    document.getElementById('btnCrearTablaGoles').addEventListener('click', () => abrirModal('tablagoles', 'crear'));

    // Iniciar con la primera pestaña activa
    document.querySelector('.tab-btn').click();
  </script>

</body>
</html>