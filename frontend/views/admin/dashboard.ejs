<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
  <title>Panel de Administración · MEJV Sports</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome 6 (gratis) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts: Space Grotesk & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
        darkMode: 'class',
        theme: {
            extend: {
                colors: {
                    'mejv-blue': '#0041f2',
                    'mejv-blue-dark': '#0033cc',
                    'mejv-dark': '#0a1e33',
                    'mejv-lime': '#bfeb30',
                    'mejv-lime-dark': '#a3cb1d',
                    'mejv-white': '#ffffff',
                    'mejv-black': '#050c18',
                    'mejv-card-dark': '#0e263e',
                    'mejv-card-hover': '#14314f'
                },
                fontFamily: {
                    sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    display: ['"Space Grotesk"', 'sans-serif'],
                },
                boxShadow: {
                    'neon-lime': '0 0 15px rgba(191, 235, 48, 0.25)',
                    'neon-blue': '0 0 15px rgba(0, 65, 242, 0.25)',
                    'card-glow': '0 4px 20px rgba(5, 12, 24, 0.15)'
                }
            }
        }
    }
  </script>

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .modal-overlay { backdrop-filter: blur(6px); }
    .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    input, select, textarea { font-size: 16px !important; }
    
    /* Custom scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #050c18;
    }
    ::-webkit-scrollbar-thumb {
      background: #0e263e;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #bfeb30;
    }
    
    /* Mobile first improvements */
    @media (max-width: 640px) {
      .tab-btn {
        padding: 0.5rem 0.75rem;
        font-size: 0.65rem;
      }
      .tab-btn i {
        font-size: 0.75rem;
      }
      .header-actions {
        flex-wrap: wrap;
        gap: 0.25rem;
      }
      .header-actions a {
        font-size: 0.6rem;
        padding: 0.3rem 0.6rem;
      }
    }
  </style>
</head>
<body class="bg-mejv-black text-gray-100 font-sans antialiased min-h-screen selection:bg-mejv-lime selection:text-mejv-black">

  <!-- ========== HEADER ========== -->
  <header class="bg-mejv-dark sticky top-0 z-20 border-b border-gray-800 shadow-neon-blue">
    <div class="max-w-7xl mx-auto px-3 py-2 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="bg-mejv-lime text-mejv-black p-1.5 rounded-xl flex items-center justify-center shadow-neon-lime">
          <i class="fas fa-chart-line text-base"></i>
        </div>
        <div>
          <h1 class="text-sm font-bold font-display text-white tracking-wide">MEJV Sports</h1>
          <p class="text-[9px] text-mejv-lime font-bold uppercase tracking-widest leading-none">Admin Panel</p>
        </div>
      </div>
      <div class="flex items-center gap-2 header-actions">
        <span class="hidden sm:inline text-gray-400 font-medium text-xs">
          <i class="far fa-calendar-alt mr-1 text-mejv-lime"></i><span id="header-date">--.--.----</span>
        </span>
        <a href="/" target="_blank" class="bg-mejv-card-dark hover:bg-mejv-card-hover border border-gray-800 text-gray-300 hover:text-white px-2 py-1 rounded-lg text-[10px] font-semibold transition flex items-center gap-1">
          <i class="fas fa-external-link-alt text-[8px]"></i> Ver Sitio
        </a>
        <a href="/admin/logout" class="bg-rose-950/40 hover:bg-rose-900/60 border border-rose-800/50 text-rose-300 hover:text-white px-2 py-1 rounded-lg text-[10px] font-semibold transition flex items-center gap-1">
          <i class="fas fa-sign-out-alt text-[10px]"></i> Salir
        </a>
      </div>
    </div>
    
    <!-- MENU PESTAÑAS (TABS) -->
    <nav class="max-w-7xl mx-auto px-2 flex gap-0.5 overflow-x-auto border-t border-gray-800 scrollbar-none">
      <button data-tab="noticias" class="tab-btn py-2 px-3 text-xs font-bold text-gray-400 border-b-2 border-transparent hover:text-mejv-lime hover:border-mejv-lime/40 whitespace-nowrap transition flex items-center gap-1.5 active">
        <i class="fas fa-newspaper text-sm"></i>Noticias
      </button>
      <button data-tab="surebets" class="tab-btn py-2 px-3 text-xs font-bold text-gray-400 border-b-2 border-transparent hover:text-mejv-lime hover:border-mejv-lime/40 whitespace-nowrap transition flex items-center gap-1.5">
        <i class="fas fa-percent text-sm"></i>Surebets
      </button>
      <button data-tab="pronosticos" class="tab-btn py-2 px-3 text-xs font-bold text-gray-400 border-b-2 border-transparent hover:text-mejv-lime hover:border-mejv-lime/40 whitespace-nowrap transition flex items-center gap-1.5">
        <i class="fas fa-futbol text-sm"></i>Pronósticos
      </button>
      <button data-tab="tablagoles" class="tab-btn py-2 px-3 text-xs font-bold text-gray-400 border-b-2 border-transparent hover:text-mejv-lime hover:border-mejv-lime/40 whitespace-nowrap transition flex items-center gap-1.5">
        <i class="fas fa-bullseye text-sm"></i>Goles
      </button>
      <!-- Acciones globales en la navegación -->
      <button id="btnValidarTodos" class="tab-btn py-2 px-3 text-xs font-bold text-amber-400 border-b-2 border-transparent hover:text-amber-300 hover:border-amber-500/40 whitespace-nowrap transition flex items-center gap-1.5 bg-amber-950/20 rounded-t-lg">
        <i class="fas fa-check-double text-sm"></i>Validar
      </button>
      <button id="toggleScraperBtn" class="tab-btn py-2 px-3 text-xs font-bold text-mejv-lime border-b-2 border-transparent hover:text-mejv-lime hover:border-mejv-lime/40 whitespace-nowrap transition flex items-center gap-1.5 bg-mejv-lime/5 rounded-t-lg">
        <i class="fas fa-robot text-sm"></i>Scraper
      </button>
    </nav>
  </header>

  <!-- ========== CONTENIDO PRINCIPAL ========== -->
  <main class="max-w-7xl mx-auto px-3 py-4 pb-24">

    <!-- ===== SECCIÓN NOTICIAS ===== -->
    <section id="section-noticias" class="tab-content">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
        <div>
          <h2 class="text-lg font-bold font-display flex items-center gap-2 text-white">
            <i class="fas fa-newspaper text-mejv-lime"></i> Gestión de Noticias
          </h2>
          <p class="text-[10px] text-gray-400">Publica artículos, fichajes y novedades deportivas</p>
        </div>
        <div class="flex flex-wrap gap-2 items-center">
          <input type="text" id="search-noticias" placeholder="Buscar..." class="bg-mejv-card-dark border border-gray-800 text-xs px-3 py-1.5 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-mejv-lime transition w-32 sm:w-44" />
          <button id="btnCrearNoticia" class="bg-mejv-blue hover:bg-mejv-blue-dark text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow-neon-blue flex items-center gap-1 transition whitespace-nowrap">
            <i class="fas fa-plus-circle"></i> Crear
          </button>
        </div>
      </div>
      
      <!-- Contenedor lista -->
      <div id="noticias-list" class="space-y-3"></div>
    </section>

    <!-- ===== SECCIÓN SUREBETS ===== -->
    <section id="section-surebets" class="tab-content hidden">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
        <div>
          <h2 class="text-lg font-bold font-display flex items-center gap-2 text-white">
            <i class="fas fa-percent text-emerald-400"></i> Arbitraje de Surebets
          </h2>
          <p class="text-[10px] text-gray-400">Gestiona surebets de apuestas seguras con retorno garantizado</p>
        </div>
        <div class="flex flex-wrap gap-2 items-center">
          <input type="text" id="search-surebets" placeholder="Buscar..." class="bg-mejv-card-dark border border-gray-800 text-xs px-3 py-1.5 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-mejv-lime transition w-32 sm:w-44" />
          <button id="btnCrearSurebet" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow flex items-center gap-1 transition whitespace-nowrap">
            <i class="fas fa-plus-circle"></i> Crear
          </button>
        </div>
      </div>
      
      <!-- Contenedor lista -->
      <div id="surebets-list" class="space-y-3"></div>
    </section>

    <!-- ===== SECCIÓN PRONÓSTICOS ===== -->
    <section id="section-pronosticos" class="tab-content hidden">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
        <div>
          <h2 class="text-lg font-bold font-display flex items-center gap-2 text-white">
            <i class="fas fa-futbol text-mejv-blue"></i> Pronósticos Premium
          </h2>
          <p class="text-[10px] text-gray-400">Publica predicciones de cuotas y evalúa su estatus final</p>
        </div>
        <div class="flex flex-wrap gap-2 items-center">
          <input type="text" id="search-pronosticos" placeholder="Buscar..." class="bg-mejv-card-dark border border-gray-800 text-xs px-3 py-1.5 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-mejv-lime transition w-32 sm:w-44" />
          <button id="btnCrearPronostico" class="bg-mejv-blue hover:bg-mejv-blue-dark text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow-neon-blue flex items-center gap-1 transition whitespace-nowrap">
            <i class="fas fa-plus-circle"></i> Crear
          </button>
        </div>
      </div>
      
      <!-- Contenedor lista -->
      <div id="pronosticos-list" class="space-y-3"></div>
    </section>

    <!-- ===== SECCIÓN TABLA DE GOLES ===== -->
    <section id="section-tablagoles" class="tab-content hidden">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
        <div>
          <h2 class="text-lg font-bold font-display flex items-center gap-2 text-white">
            <i class="fas fa-bullseye text-mejv-lime"></i> Tabla de Goles
          </h2>
          <p class="text-[10px] text-gray-400">Administra recomendaciones para el mercado over/under</p>
        </div>
        <div class="flex flex-wrap gap-2 items-center">
          <input type="text" id="search-tablagoles" placeholder="Buscar..." class="bg-mejv-card-dark border border-gray-800 text-xs px-3 py-1.5 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-mejv-lime transition w-32 sm:w-44" />
          <button id="btnCrearTablaGoles" class="bg-mejv-lime hover:bg-mejv-lime-dark text-mejv-black text-xs font-extrabold px-3 py-1.5 rounded-lg shadow-neon-lime flex items-center gap-1 transition whitespace-nowrap">
            <i class="fas fa-plus-circle"></i> Crear
          </button>
        </div>
      </div>
      
      <!-- Contenedor lista -->
      <div id="tablagoles-list" class="space-y-3"></div>
    </section>

  </main>

  <!-- ========== MODAL REUTILIZABLE ========== -->
  <div id="modalOverlay" class="fixed inset-0 bg-mejv-black/80 modal-overlay flex items-center justify-center z-50 hidden p-3">
    <div class="bg-mejv-dark border border-gray-800 rounded-2xl w-full max-w-xl shadow-2xl max-h-[92vh] overflow-y-auto transform transition duration-300 scale-95 opacity-0" id="modalContainer">
      
      <!-- Modal Header -->
      <div class="sticky top-0 bg-mejv-dark/95 backdrop-blur-md z-10 px-5 py-3 border-b border-gray-800 flex items-center justify-between rounded-t-2xl">
        <h3 id="modalTitle" class="text-sm font-bold font-display text-white flex items-center gap-2">Crear</h3>
        <button id="modalClose" class="text-gray-400 hover:text-mejv-lime text-2xl transition duration-150 leading-none">&times;</button>
      </div>
      
      <!-- Modal Body -->
      <div class="p-5">
        <form id="modalForm" class="space-y-4">
          <!-- campos dinámicos se inyectan aquí -->
          <div id="modalFields" class="space-y-4 text-gray-300"></div>
          
          <!-- botones -->
          <div class="flex justify-end gap-2.5 pt-4 border-t border-gray-800/60">
            <button type="button" id="modalCancel" class="px-4 py-1.5 text-xs font-bold border border-gray-800 rounded-xl text-gray-400 hover:text-white hover:bg-gray-800/50 transition">Cancelar</button>
            <button type="submit" id="modalSubmit" class="px-4 py-1.5 text-xs font-bold bg-mejv-blue hover:bg-mejv-blue-dark text-white rounded-xl shadow-neon-blue flex items-center gap-1.5 transition"><i class="fas fa-save"></i> Guardar</button>
          </div>
        </form>
        
        <!-- para surebets: mostrar cálculo en tiempo real -->
        <div id="surebetCalculo" class="mt-4 text-xs bg-mejv-black/60 border border-gray-800 p-4 rounded-xl hidden shadow-inner"></div>
      </div>
    </div>
  </div>

  <!-- ========== SCRIPTS ========== -->
  <script>
    // Configurar la fecha de hoy en el header del admin
    (function setHeaderDate() {
      const today = new Date();
      const options = { year: 'numeric', month: '2-digit', day: '2-digit' };
      document.getElementById('header-date').textContent = today.toLocaleDateString('es-ES', options);
    })();

    // ============================================================
    // 1. REAL API CONNECTION
    // ============================================================
    const api = {
      // Noticias
      getNoticias: () => fetch('/admin/api/news').then(handleResponse),
      crearNoticia: (formData) => fetch('/admin/api/news', { method: 'POST', body: formData }).then(handleResponse),
      editarNoticia: (id, formData) => fetch(`/admin/api/news/edit/${id}`, { method: 'POST', body: formData }).then(handleResponse),
      eliminarNoticia: (id) => fetch(`/admin/api/news/delete/${id}`, { method: 'POST' }).then(handleResponse),

      // Pronósticos
      getPronosticos: () => fetch('/admin/api/predictions').then(handleResponse),
      crearPronostico: (data) => fetch('/admin/api/predictions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).then(handleResponse),
      editarPronostico: (id, data) => fetch(`/admin/api/predictions/edit/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).then(handleResponse),
      eliminarPronostico: (id) => fetch(`/admin/api/predictions/delete/${id}`, { method: 'POST' }).then(handleResponse),
      togglePronosticoEstado: (id, status) => fetch(`/admin/api/predictions/status/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      }).then(handleResponse),

      // Surebets
      getSurebets: () => fetch('/admin/api/surebets').then(handleResponse),
      crearSurebet: (data) => fetch('/admin/api/surebets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).then(handleResponse),
      editarSurebet: (id, data) => fetch(`/admin/api/surebets/edit/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).then(handleResponse),
      eliminarSurebet: (id) => fetch(`/admin/api/surebets/delete/${id}`, { method: 'POST' }).then(handleResponse),

      // Tabla Goles
      getTablaGoles: () => fetch('/admin/api/goal-tables').then(handleResponse),
      crearTablaGoles: (data) => fetch('/admin/api/goal-tables', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).then(handleResponse),
      editarTablaGoles: (id, data) => fetch(`/admin/api/goal-tables/edit/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).then(handleResponse),
      eliminarTablaGoles: (id) => fetch(`/admin/api/goal-tables/delete/${id}`, { method: 'POST' }).then(handleResponse),
      toggleTablaGolesEstado: (id, status) => fetch(`/admin/api/goal-tables/status/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      }).then(handleResponse),
      
      // Refresh
      refreshMatch: (type, id) => fetch(`/admin/api/refresh-match/${type}/${id}`, { method: 'POST' }).then(handleResponse),

      // Scraper
      getScraperConfig: () => fetch('/admin/api/config/scraper').then(handleResponse),
      toggleScraper: (enabled) => fetch('/admin/api/config/scraper', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled })
      }).then(handleResponse)
      };

    function handleResponse(res) {
      if (!res.ok) {
        return res.json().then(err => { throw new Error(err.error || 'Error en la petición') });
      }
      return res.json();
    }

    // Almacenamiento local del estado para búsquedas en tiempo real
    const localState = {
      noticias: [],
      surebets: [],
      pronosticos: [],
      tablagoles: []
    };

    // ============================================================
    // 2. UTILIDADES DE NOTIFICACIÓN & COMPONENTES COMUNES
    // ============================================================
    function showToast(message, type = 'success') {
      const toast = document.createElement('div');
      toast.className = `fixed bottom-5 right-5 z-50 px-5 py-3 rounded-xl shadow-2xl border text-xs font-extrabold flex items-center gap-2 transform translate-y-10 opacity-0 transition-all duration-300 ${
        type === 'success' 
          ? 'bg-emerald-950/90 border-emerald-500 text-emerald-400 shadow-emerald-950/50' 
          : 'bg-rose-950/90 border-rose-500 text-rose-400 shadow-rose-950/50'
      }`;
      
      const icon = document.createElement('i');
      icon.className = type === 'success' ? 'fas fa-check-circle text-sm text-emerald-400' : 'fas fa-exclamation-circle text-sm text-rose-400';
      
      toast.appendChild(icon);
      toast.appendChild(document.createTextNode(message));
      
      document.body.appendChild(toast);
      
      setTimeout(() => {
        toast.classList.remove('translate-y-10', 'opacity-0');
      }, 10);
      
      setTimeout(() => {
        toast.classList.add('translate-y-10', 'opacity-0');
        setTimeout(() => {
          toast.remove();
        }, 300);
      }, 4000);
    }

    function renderEmptyState(container, mensaje, btnId, actionSection) {
      container.innerHTML = `
        <div class="bg-mejv-card-dark border border-dashed border-gray-800 rounded-2xl p-6 text-center shadow-card-glow max-w-xl mx-auto my-4">
          <div class="w-10 h-10 rounded-full bg-gray-900 flex items-center justify-center mx-auto mb-2">
            <i class="fas fa-folder-open text-gray-600 text-base"></i>
          </div>
          <p class="text-gray-400 text-[10px] mb-3 font-semibold">${mensaje}</p>
          <button id="${btnId}" class="bg-mejv-lime hover:bg-mejv-lime-dark text-mejv-black text-[10px] font-extrabold px-3 py-1.5 rounded-xl transition shadow-neon-lime"><i class="fas fa-plus mr-1"></i>Registrar el Primero</button>
        </div>
      `;
      document.getElementById(btnId)?.addEventListener('click', () => abrirModal(actionSection, 'crear'));
    }

    function renderSpinner(container) {
      container.innerHTML = `
        <div class="flex flex-col items-center justify-center py-8 gap-3">
          <div class="w-7 h-7 border-3 border-mejv-blue border-t-mejv-lime rounded-full animate-spin"></div>
          <p class="text-[10px] text-gray-400 font-semibold tracking-wider uppercase">Cargando datos...</p>
        </div>
      `;
    }

    function formatInputDate(dateStr) {
      if (!dateStr) return '';
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return '';
      const options = { timeZone: 'America/Bogota', year: 'numeric', month: '2-digit', day: '2-digit' };
      const parts = new Intl.DateTimeFormat('en-CA', options).formatToParts(d);
      const year = parts.find(p => p.type === 'year').value;
      const month = parts.find(p => p.type === 'month').value;
      const day = parts.find(p => p.type === 'day').value;
      return `${year}-${month}-${day}`;
    }

    function formatDisplayDate(dateStr) {
      if (!dateStr) return '';
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return '';
      const options = { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'UTC' };
      return d.toLocaleDateString('es-ES', options);
    }
    
    function getStatusColor(status) {
      switch(status) {
        case 'verificado':
          return 'bg-emerald-500 shadow-lg shadow-emerald-500/30';
        case 'fallido':
          return 'bg-rose-500 shadow-lg shadow-rose-500/30';
        case 'return':
          return 'bg-amber-500 shadow-lg shadow-amber-500/30';
        case 'pendiente':
        default:
          return 'bg-gray-500 shadow-lg shadow-gray-500/20';
      }
    }
    
    function getSurebetStatusColor(percentage) {
      if (!percentage) return 'bg-gray-500 shadow-lg shadow-gray-500/20';
      const num = parseFloat(percentage);
      if (isNaN(num)) return 'bg-gray-500 shadow-lg shadow-gray-500/20';
      if (num >= 2) return 'bg-emerald-500 shadow-lg shadow-emerald-500/30';
      if (num >= 1) return 'bg-amber-500 shadow-lg shadow-amber-500/30';
      return 'bg-rose-500 shadow-lg shadow-rose-500/30';
    }

    // ============================================================
    // 3. RENDERIZADO DE TABLAS / LISTADOS
    // ============================================================
    function renderTablaNoticias(lista, container) {
      if (!lista.length) {
        renderEmptyState(container, 'No se encontraron noticias en esta sección.', 'btnEmptyCrearNoticia', 'noticias');
        return;
      }
      let html = `
        <div class="bg-mejv-card-dark border border-gray-800 rounded-2xl shadow-card-glow overflow-hidden">
          <div class="table-wrap">
            <table class="w-full text-xs text-left">
              <thead class="bg-mejv-black text-gray-400 font-bold uppercase tracking-wider border-b border-gray-800">
                <tr>
                  <th class="px-3 py-2">Título</th>
                  <th class="px-3 py-2 hidden sm:table-cell">Descripción</th>
                  <th class="px-3 py-2">Tag</th>
                  <th class="px-3 py-2 text-center hidden xs:table-cell">Img</th>
