<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestionar Noticias - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root {
          --bg-color: #edebe4;
          --text-color: #1a1c21;
          --primary-color: #e21c1b;
          --light-shadow: #dbd7c5;
          --dark-shadow: #cac7b5;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Inter', sans-serif;
        }
        .neumorphic-flat {
            background: var(--bg-color);
            box-shadow: 7px 7px 15px var(--dark-shadow), -7px -7px 15px var(--light-shadow);
        }
        .neumorphic-input {
            background: var(--bg-color);
            box-shadow: inset 4px 4px 8px var(--dark-shadow), inset -4px -4px 8px var(--light-shadow);
            border: none;
            outline: none;
        }
        .neumorphic-button {
            background: var(--bg-color);
            box-shadow: 5px 5px 10px var(--dark-shadow), -5px -5px 10px var(--light-shadow);
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .neumorphic-button:active {
            box-shadow: inset 3px 3px 6px var(--dark-shadow), inset -3px -3px 6px var(--light-shadow);
            transform: scale(0.98);
        }
    </style>
</head>
<body class="p-4 md:p-8">
    <div class="max-w-6xl mx-auto">
        <header class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
            <h1 class="text-3xl font-bold" style="color: var(--primary-color);">Gestionar Noticias</h1>
            <div class="flex gap-4">
                <a href="/admin" class="neumorphic-button px-4 py-2 rounded-lg text-sm">Dashboard</a>
                <a href="/admin/logout" class="neumorphic-button px-4 py-2 rounded-lg text-sm text-red-500">Cerrar Sesión</a>
            </div>
        </header>
        
        <form action="/admin/news" method="POST" enctype="multipart/form-data" class="neumorphic-flat p-6 rounded-xl mb-8">
            <input type="text" name="title" placeholder="Título" class="neumorphic-input w-full p-3 mb-4 rounded-lg" required>
            <textarea name="body" placeholder="Cuerpo de la noticia" class="neumorphic-input w-full p-3 mb-4 rounded-lg h-32"></textarea>
            <input type="file" name="image" accept="image/*" class="mb-4 text-sm neumorphic-input p-2 rounded-lg" required>
            <button type="submit" class="neumorphic-button px-6 py-2 rounded-lg font-bold block">Crear Noticia</button>
        </form>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <% news.forEach(n => { %>
                <div class="neumorphic-flat p-4 rounded-xl">
                    <form action="/admin/news/edit/<%= n._id %>" method="POST" enctype="multipart/form-data">
                        <img src="<%= n.imageUrl %>" class="w-full h-32 object-cover rounded-lg mb-2">
                        <input type="file" name="image" accept="image/*" class="w-full text-xs mb-2">
                        <input type="text" name="title" value="<%= n.title %>" class="neumorphic-input w-full p-2 mb-2 rounded-lg font-bold text-sm">
                        <textarea name="body" class="neumorphic-input w-full p-2 mb-2 rounded-lg h-20 text-xs"><%= n.body %></textarea>
                        <div class="flex justify-end gap-2">
                            <button type="submit" class="neumorphic-button px-3 py-1 rounded-lg text-xs font-bold">GUARDAR</button>
                        </div>
                    </form>
                    <form action="/admin/news/delete/<%= n._id %>" method="POST" class="mt-2">
                        <button type="submit" class="neumorphic-button px-3 py-1 rounded-lg text-xs font-bold text-red-500">BORRAR</button>
                    </form>
                </div>
            <% }) %>
        </div>
    </div>
    <script>
        lucide.createIcons();
    </script>
</body>
</html>
