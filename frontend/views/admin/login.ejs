<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Admin - MEJV Sports</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
          --bg-color: #edebe4;
          --text-color: #1a1c21;
          --primary-color: #e21c1b;
          --light-shadow: #dbd7c5;
          --dark-shadow: #cac7b5;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .neumorphic-flat {
            background: var(--bg-color);
            box-shadow: 7px 7px 15px var(--dark-shadow), -7px -7px 15px var(--light-shadow);
        }
        .neumorphic-button {
            background: var(--bg-color);
            box-shadow: 5px 5px 10px var(--dark-shadow), -5px -5px 10px var(--light-shadow);
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .neumorphic-button:active {
            box-shadow: inset 3px 3px 6px var(--dark-shadow), inset -3px -3px 6px var(--light-shadow);
            transform: scale(0.98);
        }
    </style>
</head>
<body class="p-4">
    <form action="/admin/login" method="POST" class="neumorphic-flat p-8 rounded-xl w-full max-w-sm">
        <h2 class="text-2xl font-bold mb-6 text-center" style="color: var(--primary-color);">Login Administración</h2>
        <input type="text" name="username" placeholder="Usuario" class="w-full p-3 mb-4 neumorphic-input rounded-lg" required>
        <input type="password" name="password" placeholder="Contraseña" class="w-full p-3 mb-6 neumorphic-input rounded-lg" required>
        <button type="submit" class="neumorphic-button w-full p-3 rounded-lg font-bold">Entrar</button>
    </form>
</body>
</html>
