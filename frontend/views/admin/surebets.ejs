<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestionar Surebets - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root {
          --bg-color: #edebe4;
          --text-color: #1a1c21;
          --primary-color: #e21c1b;
          --light-shadow: #dbd7c5;
          --dark-shadow: #cac7b5;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Inter', sans-serif;
        }
        .neumorphic-flat {
            background: var(--bg-color);
            box-shadow: 7px 7px 15px var(--dark-shadow), -7px -7px 15px var(--light-shadow);
        }
        .neumorphic-input {
            background: var(--bg-color);
            box-shadow: inset 4px 4px 8px var(--dark-shadow), inset -4px -4px 8px var(--light-shadow);
            border: none;
            outline: none;
        }
        .neumorphic-button {
            background: var(--bg-color);
            box-shadow: 5px 5px 10px var(--dark-shadow), -5px -5px 10px var(--light-shadow);
            transition: all 0.2s ease;
        }
        .neumorphic-button:active {
            box-shadow: inset 3px 3px 6px var(--dark-shadow), inset -3px -3px 6px var(--light-shadow);
            transform: scale(0.98);
        }
    </style>
</head>
<body class="p-4 md:p-8">
    <div class="max-w-5xl mx-auto">
        <header class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
            <h1 class="text-3xl font-bold" style="color: var(--primary-color);">Gestionar Surebets</h1>
            <div class="flex gap-4">
                <a href="/admin" class="neumorphic-button px-4 py-2 rounded-lg text-sm">Dashboard</a>
                <a href="/admin/logout" class="neumorphic-button px-4 py-2 rounded-lg text-sm text-red-500">Cerrar Sesión</a>
            </div>
        </header>
        
        <form id="surebet-form" action="/admin/surebets" method="POST" class="neumorphic-flat p-6 rounded-xl mb-8 grid grid-cols-1 md:grid-cols-3 gap-4">
            <input type="text" name="event" placeholder="Encuentro" class="neumorphic-input p-3 rounded-lg" required>
            <input type="date" name="eventDate" placeholder="Fecha del Encuentro" class="neumorphic-input p-3 rounded-lg" required>
            <input type="time" name="time" placeholder="Hora" class="neumorphic-input p-3 rounded-lg" required>
            <input type="text" name="market" placeholder="Mercado" class="neumorphic-input p-3 rounded-lg" required>
            <input type="text" name="line" placeholder="Línea" class="neumorphic-input p-3 rounded-lg" required>
            <input type="text" name="percentage" id="percentage" placeholder="%" class="neumorphic-input p-3 rounded-lg" readonly>
            <input type="text" name="bookmaker1" placeholder="Casa 1" class="neumorphic-input p-3 rounded-lg" required>
            <input type="number" step="0.01" name="odds1" id="odds1" placeholder="Cuota 1" class="neumorphic-input p-3 rounded-lg" required>
            <input type="text" name="bookmaker2" placeholder="Casa 2" class="neumorphic-input p-3 rounded-lg" required>
            <input type="number" step="0.01" name="odds2" id="odds2" placeholder="Cuota 2" class="neumorphic-input p-3 rounded-lg" required>
            <div class="md:col-span-3 text-sm font-bold opacity-70">
                Stake 1: <span id="stake1">0</span> | Stake 2: <span id="stake2">0</span>
            </div>
            <button type="submit" class="neumorphic-button p-3 rounded-lg font-bold md:col-span-3">Crear Surebet</button>
        </form>

        <script>
            const odds1Input = document.getElementById('odds1');
            const odds2Input = document.getElementById('odds2');
            const percentageInput = document.getElementById('percentage');
            const stake1El = document.getElementById('stake1');
            const stake2El = document.getElementById('stake2');

            function calculateSurebet() {
                const o1 = parseFloat(odds1Input.value);
                const o2 = parseFloat(odds2Input.value);

                if (o1 > 0 && o2 > 0) {
                    const arb = (1/o1 + 1/o2);
                    const perc = ((1/arb - 1) * 100).toFixed(2);
                    percentageInput.value = perc + '%';

                    const totalStake = 100;
                    const s1 = (totalStake / (o1 * arb)).toFixed(2);
                    const s2 = (totalStake / (o2 * arb)).toFixed(2);
                    stake1El.textContent = s1;
                    stake2El.textContent = s2;
                }
            }

            odds1Input.addEventListener('input', calculateSurebet);
            odds2Input.addEventListener('input', calculateSurebet);
        </script>

        <div class="grid gap-4">
            <% data.forEach(d => { %>
                <div class="neumorphic-flat p-4 rounded-xl flex justify-between items-center">
                    <span class="font-semibold"><%= d.event %> - <span class="text-[var(--primary-color)]"><%= d.percentage %>%</span></span>
                    <form action="/admin/surebets/delete/<%= d._id %>" method="POST">
                        <button type="submit" class="neumorphic-button px-4 py-1 rounded-lg text-xs font-bold text-red-500">Borrar</button>
                    </form>
                </div>
            <% }) %>
        </div>
    </div>
    <script>
        lucide.createIcons();
    </script>
</body>
</html>
